<% cache(event) do %>
  <div class="card" id="<%= dom_id(event, "card") %>">
    <div class="card-body">
      <h5 class="card-title text-green-600"><%= event.name %></h5>

      <div class="card-attributes grid grid-cols-2 gap-2 mt-4">
        <!-- Date Range -->
        <div class="flex items-center">
          <i class="bi bi-calendar-range text-green-600 mr-2"></i>
          <span class="text-sm">
            <strong>Schedule:</strong>
            <span><%= event.start_date.strftime("%Y-%m-%d") %></span> to <span><%= event.end_date.strftime("%Y-%m-%d") %></span>
          </span>
        </div>

        <!-- Location -->
        <div class="flex items-center">
          <i class="bi bi-geo-alt text-green-600 mr-2"></i>
          <strong>Location:</strong>
          <span class="text-sm">
            <span><%= event.location %></span>
          </span>
        </div>

        <!-- Audience -->
        <div class="flex items-center">
          <i class="bi bi-people text-green-600 mr-2"></i>
          <strong>For:</strong>
          <span class="text-sm">
            <span><%= event.audience.titleize %></span>
          </span>
        </div>
      </div>

      <div class="text-end mt-4">
        <%= link_to event_path(event.public_uid), class: "btn btn-outline-green-600", data: { turbo: :false } do %>
          <i class="bi bi-eye mr-2"></i>
          View Details
        <% end %>
      </div>
    </div>
  </div>
<% end %>