<% if events.empty? %>
  <div class="p-5">
    <div class="mb-3">
      <h2 id="carousel-heading">Upcoming Events</h2>
    </div>
    <div class="text-center">
      <span class="badge bg-green-600 py-3 px-4">EMPTY EVENT</span>
    </div>
  </div>
<% else %>
  <section class="splide" aria-label="Events" data-splide-loader-target="multipleSlides" id="EventCarousel">
    <div class="mb-3">
      <h2 id="carousel-heading">Upcoming Events</h2>
    </div>

    <div class="splide__track">
      <ul class="splide__list">
        <% events.each do |event| %>
          <li class="splide__slide">
            <%= render partial: "barangay/events/card", locals: { event: event } %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
<% end %>