<%= search_form_for @q, url: appointments_path, class: "row g-2 align-items-end" do |f| %>
  <%= hidden_field_tag :filter, params[:filter] if params[:filter].present? %>

  <div class="col-12 col-sm-6 col-lg-3">
    <%= f.label :status_eq, "Status", class: "form-label small fw-semibold text-secondary mb-1" %>
    <%= f.select :status_eq,
        Appointment.statuses.map { |key, value| [key.titleize, value] },
        { include_blank: "All Statuses" },
        { class: "form-select form-select-sm" } %>
  </div>

  <div class="col-6 col-sm-6 col-lg-3">
    <%= f.label :scheduled_at_gteq, "From Date", class: "form-label small fw-semibold text-secondary mb-1" %>
    <%= f.datetime_field :scheduled_at_gteq, class: "form-control form-control-sm" %>
  </div>

  <div class="col-6 col-sm-6 col-lg-3">
    <%= f.label :scheduled_at_lteq, "To Date", class: "form-label small fw-semibold text-secondary mb-1" %>
    <%= f.datetime_field :scheduled_at_lteq, class: "form-control form-control-sm" %>
  </div>

  <div class="col-12 col-sm-6 col-lg-3 d-flex gap-2">
    <button class="btn btn-sm btn-emerald flex-grow-1 py-2" type="submit">
      <i class="bi bi-funnel me-1"></i>Filter
    </button>
    <%= link_to appointments_path, class: "btn btn-sm btn-light border py-2 px-3", title: "Reset" do %>
      <i class="bi bi-arrow-counterclockwise"></i>
    <% end %>
  </div>
<% end %>
