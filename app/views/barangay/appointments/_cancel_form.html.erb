<%= form_with(model: appointment, url: cancel_schedule_appointment_path(appointment.public_uid)) do |form| %>
  <% if appointment.errors.any? %>
    <div class="alert alert-danger small py-2 px-3 rounded-3 mb-3">
      <i class="bi bi-exclamation-triangle-fill me-1"></i>
      <%= appointment.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <p class="small text-secondary mb-3">
    Cancelling frees up your slot for another resident in Brgy. <%= ActsAsTenant.current_tenant&.name %>.
  </p>

  <div class="mb-3">
    <%= form.label :cancel_reason, "Reason for Cancelling *", class: "form-label fw-bold small" %>
    <%= form.textarea :cancel_reason, rows: 3, class: "form-control", placeholder: "Please share a brief reason...", required: true %>
  </div>

  <div class="d-flex justify-content-end gap-2 pt-2 border-top">
    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Keep Visit</button>
    <%= form.submit "Yes, Cancel My Visit", class: "btn btn-danger fw-bold px-4", data: { turbo_confirm: "Are you sure you want to cancel this appointment?", turbo_submits_with: "Cancelling..." } %>
  </div>
<% end %>
