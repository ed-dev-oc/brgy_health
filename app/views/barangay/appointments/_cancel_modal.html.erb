<div class="modal fade" id="<%= dom_id(@appointment, 'cancel_schedule_modal') %>" tabindex="-1" aria-labelledby="<%= dom_id(@appointment, 'cancel_schedule_modal') %>Label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom px-4 py-3">
        <div class="d-flex align-items-center gap-2">
          <span class="pt-icon-circle circle-rose" style="width: 38px; height: 38px; font-size: 1.1rem;">
            <i class="bi bi-x-circle-fill"></i>
          </span>
          <div>
            <h5 class="modal-title fw-bold text-danger mb-0" id="<%= dom_id(@appointment, 'cancel_schedule_modal') %>Label">Cancel This Visit?</h5>
            <small class="text-secondary">Visit #<%= @appointment.public_uid %></small>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <%= turbo_frame_tag dom_id(@appointment, "cancel_schedule_form") do %>
          <%= render partial: "barangay/appointments/cancel_form", locals: { appointment: @appointment } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
