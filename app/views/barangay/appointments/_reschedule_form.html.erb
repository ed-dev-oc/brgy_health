<%= form_with(model: appointment, url: flag_as_reschedule_appointment_path(appointment.public_uid)) do |form| %>
  <% if appointment.errors.any? %>
    <div class="alert alert-danger small py-2 px-3 rounded-3 mb-3">
      <i class="bi bi-exclamation-triangle-fill me-1"></i>
      <%= appointment.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <% ann = appointment.announcement %>
  <% if ann.present? %>
    <div class="p-3 rounded-3 mb-3 small" style="background: var(--pt-emerald-50); border: 1px solid #a7f3d0;">
      <div class="fw-bold text-success mb-1"><i class="bi bi-calendar-check me-1"></i>Allowed Schedule Window:</div>
      <div>
        <strong><%= ann.start_date.strftime("%b %d") %> – <%= ann.end_date.strftime("%b %d, %Y") %></strong>
        (<%= ann.open_time.strftime("%I:%M %p") %> – <%= ann.close_time.strftime("%I:%M %p") %>)
      </div>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :scheduled_at, "New Date & Time *", class: "form-label fw-bold small" %>
    <%= form.datetime_field :scheduled_at, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :reschedule_reason, "Why do you need to change the date? *", class: "form-label fw-bold small" %>
    <%= form.textarea :reschedule_reason, rows: 3, class: "form-control", placeholder: "e.g., Conflict with work or school schedule...", required: true %>
  </div>

  <div class="d-flex justify-content-end gap-2 pt-2 border-top">
    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Close</button>
    <%= form.submit "Save New Date", class: "btn btn-emerald-lg", data: { turbo_confirm: "Are you sure you want to reschedule this visit?", turbo_submits_with: "Saving..." } %>
  </div>
<% end %>
