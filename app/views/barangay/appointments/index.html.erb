<div class="container py-3">
  <div class="row mb-4">
    <div class="col">
      <h1 class="display-5 fw-bold">My Appointments</h1>
      <p class="lead">View and manage your scheduled appointments</p>
    </div>
    <div class="col-auto">
      <a href="#" class="btn btn-green-600 btn-lg">
        <i class="bi bi-plus-circle"></i> New Appointment
      </a>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col">
      <div class="card shadow-sm">
        <div class="card-body">
          <%= render partial: "barangay/appointments/search_form" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col">
      <div class="card shadow-sm">
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <%# Example appointment - this would be in a loop in Rails %>

            <% @appointments.each do |appointment| %>
              <%= link_to appointment_path(appointment.public_uid), class: "list-group-item list-group-item-action p-4" do %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h5 class="mb-0"><%= appointment.announcement.name %></h5>
                  <span class="badge <%= badge_status_class(appointment.status) %> rounded-pill"><%= appointment.status.titleize %></span>
                </div>
                <div class="row">
                  <div class="col-md-4">
                    <p class="mb-1">
                      <i class="bi bi-calendar-event"></i>
                      <strong>Date:</strong>
                      <%= appointment.scheduled_at.strftime("%B %d, %Y") %>
                    </p>
                    <p class="mb-1">
                      <i class="bi bi-clock"></i>
                      <strong>Time:</strong>
                      <%= appointment.scheduled_at.strftime("%I:%M %p") %>
                    </p>
                  </div>
                  <div class="col-md-4">
                    <p class="mb-1">
                      <i class="bi bi-person-badge"></i>
                      <strong>Health Worker:</strong>
                      <%= appointment.health_worker&.full_name %>
                    </p>
                    <p class="mb-1">
                      <i class="bi bi-geo-alt"></i>
                      <strong>Location:</strong>
                      <%= appointment.announcement.location %>
                    </p>
                  </div>
                  <div class="col-md-4">
                    <p class="text-muted mb-0">
                      <i class="bi bi-chat-left-text"></i>
                      <strong>Notes:</strong>
                      <% if appointment.notes.present? %>
                        <%= appointment.notes %>
                      <% else %>
                        <span class="badge text-bg-secondary rounded-pill">N/A</span>
                      <% end %>
                    </p>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <nav class="mt-4">
        <div class="d-flex justify-content-center">
          <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
        </div>
      </nav>
    </div>
  </div>
</div>