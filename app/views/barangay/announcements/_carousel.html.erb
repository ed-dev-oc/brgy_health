<% if announcements.empty? %>
  <div class="pt-card p-4 text-center mb-4">
    <div class="pt-icon-circle circle-emerald mx-auto mb-2">
      <i class="bi bi-calendar2-check"></i>
    </div>
    <h6 class="fw-bold mb-1">No Active Health Service Schedules Right Now</h6>
    <p class="text-secondary small mb-0">
      New free check-up and vaccination schedules will be posted here soon.
    </p>
  </div>
<% else %>
  <div class="pt-desktop-grid-2 mb-4" id="AnnouncementCarousel">
    <% announcements.each do |announcement| %>
      <%= render partial: "barangay/announcements/card", locals: { announcement: announcement } %>
    <% end %>
  </div>
<% end %>
