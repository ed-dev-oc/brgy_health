<div data-controller="splide-loader">
  <!-- Main Slider -->
  <div data-splide-loader-target="mainSlides" class="splide" style="padding: 1px !important;">
    <div class="splide__track">
      <ul class="splide__list">
        <% announcement.images.each do |image| %>
          <li class="splide__slide">
            <%= image_tag(image.variant(resize_to_fill: [900, 600])) %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <!-- Thumbnail Slider -->
  <div data-splide-loader-target="thumbnailSlides" class="splide" style="padding-top: 1px !important; padding-bottom: 1px !important;">
    <div class="splide__track">
      <ul class="splide__list">
        <% announcement.images.each do |image| %>
          <li class="splide__slide">
            <%= image_tag(image.variant(resize_to_fill: [900, 600])) %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

<div class="my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Status Badge -->
      <div class="mb-4">
        <span class="badge <%= badge_status_class(announcement.status) %>">
          <%= announcement.status.titleize %>
        </span>
      </div>

      <!-- Title -->
      <h1 class="display-5 fw-bold mb-4"><%= announcement.name %></h1>

      <!-- Description (rich text) -->
      <div class="rich-text-content mb-5">
        <%= announcement.description %>
      </div>

      <!-- Details Card -->
      <div class="card border-0 shadow-sm mb-5">
        <div class="card-body">
          <h5 class="card-title text-green-600 mb-4">Event Details</h5>

          <div class="row">
            <!-- Date and Time -->
            <div class="col-md-6 mb-3">
              <h6 class="text-muted small mb-1">Date</h6>
              <p class="mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <%= announcement.start_date.to_date.to_formatted_s(:long) %>
                <% if announcement.start_date.to_date != announcement.end_date.to_date %>
                  to <%= announcement.end_date.to_date.to_formatted_s(:long) %>
                <% end %>
              </p>

              <h6 class="text-muted small mb-1"><i class="bi bi-clock me-2"></i> Time</h6>
              <p>
                <%= announcement.open_time.strftime("%I:%M %p") %> to 
                <%= announcement.close_time.strftime("%I:%M %p") %>
              </p>
            </div>

            <!-- Location and Capacity -->
            <div class="col-md-6 mb-3">
              <% if announcement.location.present? %>
                <h6 class="text-muted small mb-1"><i class="bi bi-geo-alt me-2"></i> Location</h6>
                <p class="mb-3"><%= announcement.location %></p>
              <% end %>

              <% if announcement.max_patients.present? %>
                <h6 class="text-muted small mb-1"><i class="bi bi-people me-2"></i> Maximum Participants</h6>
                <p><%= announcement.max_patients %></p>
              <% end %>
            </div>
          </div>

          <!-- Audience -->
          <% if announcement.audience.present? %>
            <h6 class="text-muted small mb-1">Intended For</h6>
            <div class="d-flex flex-wrap gap-1">
              <% announcement.audience.split(',').each do |audience| %>
                <span class="badge bg-green-600"><%= audience %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Health Program Description Card -->
      <div class="card border-0 mb-5" style="background-color: #f0f7ff;">
        <div class="card-body">
          <h5 class="card-title text-green-600 mb-3">About the Health Program</h5>
          <h6 class="text-muted small mb-2"><%= announcement.health_program.name %></h6>
          <div class="rich-text-content">
            <p><%= announcement.health_program.description %></p>
          </div>
        </div>
      </div>

      <!-- Additional Information -->
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <% if announcement.barangay.present? %>
          <div>
            <h6 class="text-muted small mb-1">Barangay</h6>
            <p class="mb-0"><%= announcement.barangay.name %></p>
          </div>
        <% end %>

        <% if announcement.posted_by.present? %>
          <div>
            <h6 class="text-muted small mb-1">Posted By</h6>
            <p class="mb-0"><%= announcement.posted_by.full_name %></p>
          </div>
        <% end %>

        <% if announcement.health_program.present? %>
          <div>
            <h6 class="text-muted small mb-1">Health Program</h6>
            <p class="mb-0"><%= announcement.health_program.name %></p>
          </div>
        <% end %>
      </div>

      <div class="d-flex justify-content-center gap-3 mt-5">
        <%= link_to "View All Announcements", root_path(anchor: :AnnouncementCarousel), class: "btn btn-outline-secondary px-5 py-3" %>

        <%= link_to "Set Appointment", "#", class: "btn btn-green-600 px-5 py-3", data: { bs_toggle: "modal", bs_target: "##{dom_id(@appointment, "form")}"} if user_signed_in? %>
      </div>
    </div>
  </div>
</div>