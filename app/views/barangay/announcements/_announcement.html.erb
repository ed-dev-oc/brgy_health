<div id="<%= dom_id announcement %>" class="card">
  <div class="card-body">
    <h5 class="card-title"><%= announcement.name %></h5>
    <div class="border p-2">
      <%= announcement.description %>
    </div>
    <p>
      <%= link_to "Show this announcement", announcement_path(announcement.public_uid) %>
    </p>
  </div>
</div>
