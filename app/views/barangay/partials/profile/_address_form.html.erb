<%= form_for(@user, url: profile_path(@user.id), html: { method: :patch, class: "needs-validation" }) do |form| %>
  <div class="sa-card p-4">
    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
      <span class="sa-icon-well well-amber" style="width: 36px; height: 36px; font-size: 1rem;">
        <i class="bi bi-geo-alt-fill"></i>
      </span>
      <div>
        <h6 class="fw-bold text-dark mb-0">Subdivision / Purok Assignment</h6>
        <small class="text-secondary">Brgy. <%= @user.barangay&.name %> local zone</small>
      </div>
    </div>

    <% if @user.errors.any? %>
      <div class="alert alert-danger rounded-3 small mb-3">
        <div class="fw-bold mb-1"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</div>
        <ul class="mb-0 ps-3">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :subdivision_id, "Select Existing Purok / Subdivision", class: "form-label fw-semibold small" %>
      <%= form.collection_select :subdivision_id,
            @subdivisions,
            :id, :name,
            { include_blank: "None / Not Listed" },
            class: "form-select" %>
    </div>

    <div class="mb-3">
      <%= label_tag :new_subdivision_name, "Or Enter a New Purok / Subdivision", class: "form-label fw-semibold small" %>
      <%= text_field_tag :new_subdivision_name, nil, class: "form-control", placeholder: "e.g. Purok 1, Sitio Maligaya" %>
    </div>

    <div class="d-grid">
      <%= form.submit "Update Purok / Subdivision", class: "btn btn-emerald btn-sm" %>
    </div>
  </div>
<% end %>
