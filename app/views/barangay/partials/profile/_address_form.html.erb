<%= form_for(@user, url: profile_path(@user.id), html: { method: :patch, class: "needs-validation" }) do |form| %>
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">Update Subdivision (Purok)</h5>

      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h6>
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Select from existing subdivisions -->
      <div class="mb-3">
        <%= form.label :subdivision_id, "Select Existing Subdivision", class: "form-label" %>
        <%= form.collection_select :subdivision_id,
              @subdivisions, # Use the loaded subdivisions from the controller
              :id, :name,
              { include_blank: "None / Not Listed" },
              class: "form-select" %>
      </div>

      <!-- Or enter a new subdivision -->
      <div class="mb-3">
        <%= label_tag :new_subdivision_name, "Or Enter New Subdivision", class: "form-label" %>
        <%= text_field_tag :new_subdivision_name, nil, class: "form-control", placeholder: "e.g. Purok Uno" %>
      </div>

      <div class="d-grid mt-3">
        <%= form.submit "Update", class: "btn btn-primary" %>
      </div>
    </div>
  </div>
<% end %>
