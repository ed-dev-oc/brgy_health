<div class="sa-card p-4">
  <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
    <span class="sa-icon-well well-purple" style="width: 36px; height: 36px; font-size: 1rem;">
      <i class="bi bi-shield-lock-fill"></i>
    </span>
    <div>
      <h6 class="fw-bold text-dark mb-0">Account Security &amp; Credentials</h6>
      <small class="text-secondary">Update your login email address or password</small>
    </div>
  </div>

  <%= form_with model: @user, url: profile_path(@user.id), local: true do |form| %>
    <div class="row g-3">
      <div class="col-12">
        <%= form.label :email, "Email Address *", class: "form-label fw-semibold small" %>
        <%= form.email_field :email, class: "form-control", required: true %>
      </div>

      <div class="col-md-6">
        <%= form.label :password, "New Password", class: "form-label fw-semibold small" %>
        <div class="input-group" data-controller="password-visibility">
          <%= form.password_field :password, class: "form-control", data: { password_visibility_target: "passwordInput" }, placeholder: "Leave blank to keep current" %>
          <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
            <i class="bi bi-eye" data-password-visibility-target="icon"></i>
          </button>
        </div>
      </div>

      <div class="col-md-6">
        <%= form.label :password_confirmation, "Confirm New Password", class: "form-label fw-semibold small" %>
        <div class="input-group" data-controller="password-visibility">
          <%= form.password_field :password_confirmation, class: "form-control", data: { password_visibility_target: "passwordInput" }, placeholder: "Confirm new password" %>
          <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
            <i class="bi bi-eye" data-password-visibility-target="icon"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end mt-3 pt-3 border-top">
      <%= form.submit "Update Credentials", class: "btn btn-emerald px-4" %>
    </div>
  <% end %>
</div>
