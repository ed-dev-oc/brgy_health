<div class="card">
  <div class="card-body">
    <h5 class="card-title">Update Credentials</h5>
    <%= form_with model: @user, url: profile_path(@user.id), local: true do |form| %>
      <div class="mb-3">
        <%= form.label :email, class: "form-label" %>
        <%= form.email_field :email, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :password, class: "form-label" %>

        <div class="input-group" data-controller="password-visibility">
          <%= form.password_field :password, class: "form-control", data: { password_visibility_target: "passwordInput"} %>
          <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
            <i class="bi bi-eye" data-password-visibility-target="icon"></i>
          </button>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :password_confirmation, class: "form-label" %>

        <div class="input-group" data-controller="password-visibility">
          <%= form.password_field :password_confirmation, class: "form-control", data: { password_visibility_target: "passwordInput"} %>
          <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
            <i class="bi bi-eye" data-password-visibility-target="icon"></i>
          </button>
        </div>
      </div>

      <%= form.submit "Update Credentials", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
