<section class="hero-banner" style="background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), 
  url(<%= url_for(@hero_banner.image) %>);">
  <div class="container">
    <div class="hero-content">
      <h1 class="display-4 fw-bold mb-4"><%= @hero_banner.title %></h1>
      <p class="lead mb-4"><%= @hero_banner.subheadline %></p>
      <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
        <%= link_to "View Announcements", announcements_path, class: "btn btn-primary btn-lg btn-cta" %>

        <button type="button" class="btn btn-outline-light btn-lg btn-cta">View Events</button>
      </div>
    </div>
  </div>
</section>

<% if user_signed_in? %>
  <%= edit_profile_button(current_user) %>
  <%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :DELETE, turbo_confirm: "Are your sure?" }, class: "btn btn-danger" %>
<% end %>
