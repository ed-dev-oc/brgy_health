<section class="hero-section py-5 mb-3" style="background-color: #e3f2fd;">
  <div class="container text-center">
    <h1><%= @page.title %></h1>
    <p class="lead"><%= @page.subheadline %></p>
  </div>
</section>

<div class="container">
  <div class="row row-gap-4">
    <div class="col-12 col-lg-6">
      <%= @page.content %>
    </div>
    <div class="col-lg-6">
      <h2 style="font-size: 32px;">Send Us a Email</h2>
      <form method="post" action="mailto:<%= @admin.email %>" enctype="text/plain">
        <div class="mb-3"><label class="form-label" for="name" style="font-size: 16px;">Full Name</label><input class="form-control form-control" type="text" id="name" name="name" required=""></div>
        <div class="mb-3"><label class="form-label" for="email" style="font-size: 16px;">Email Address</label><input class="form-control form-control" type="email" id="email" name="email" required=""></div>
        <div class="mb-3"><label class="form-label" for="name" style="font-size: 16px;">Subject</label><input class="form-control form-control" type="text" id="name" name="subject" required=""></div>
        <div class="mb-3"><label class="form-label" for="message" style="font-size: 16px;">Message</label>
          <textarea class="form-control form-control" id="message" name="body" required="" rows="5"></textarea>
        </div>
        <button class="btn btn-primary" type="submit" style="font-size: 16px;">Send Message</button>
      </form>
    </div>
    <div class="col-12">
      <h2>Location Map</h2>
      <div style="width: 100%; height: 400px" data-controller="leaflet"
        data-leaflet-lat-value="<%= @page.latitude %>"
        data-leaflet-lng-value="<%= @page.longitude %>"
        data-leaflet-title-value="<%= @page.title %>">
      </div>
    </div>
  </div>
</div>
