<% content_for :title, "Health Programs" %>

<div class="container mt-4">
  <div class="row mb-4">
    <div class="col-md-4">
      <%= form_with url: admin_health_programs_path, method: :get, local: true do %>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <%= text_field_tag :q, @query, class: "form-control", type: "search", placeholder: "Search programs..." %>
          <button class="btn btn-green-600" type="submit">Search</button>
        </div>
      <% end %>
    </div>
    <div class="col-md-8 text-md-end">
      <button class="btn btn-green-600" data-bs-toggle="modal" data-bs-target="#newHealthProgramModal">
        New Health Program
      </button>
    </div>
  </div>

  <% if @admin_health_programs.any? %>
    <div class="row g-3">
      <% @admin_health_programs.each do |admin_health_program| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="card-title">
                <%= admin_health_program.name.presence || "Untitled Program" %>
              </h5>
              <p class="card-text">
                <%= truncate(admin_health_program.description, length: 100) %>
              </p>
              <%= link_to "View Details", [:admin, admin_health_program], class: "btn btn-outline-green-600 btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-3">
      <%== pagy_bootstrap_nav(@pagy) if @pagy&.pages.to_i > 1 %>
    </div>
  <% else %>
    <div class="alert alert-info">
      No health programs found.
    </div>
  <% end %>
</div>

<%= render "new_modal", admin_health_program: HealthProgram.new %>
