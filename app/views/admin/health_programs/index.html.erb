<% content_for :title, "Health Programs Catalog — Brgy. #{ActsAsTenant.current_tenant&.name}" %>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h3 class="fw-bold mb-1">Health Programs Catalog</h3>
    <p class="text-secondary small mb-0">
      Organize clinic initiatives such as Maternal Care, Immunization, Senior Wellness, and Dental Services.
    </p>
  </div>

  <div>
    <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#newHealthProgramModal">
      <i class="bi bi-plus-lg me-1"></i>New Health Program
    </button>
  </div>
</div>

<!-- Search Bar -->
<div class="sa-card p-3 mb-4">
  <%= form_with url: admin_health_programs_path, method: :get, local: true, class: "d-flex flex-wrap gap-2 justify-content-between align-items-center" do %>
    <div class="input-group input-group-sm" style="max-width: 420px;">
      <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
      <%= text_field_tag :q, @query, class: "form-control border-start-0", type: "search", placeholder: "Search health program name or description..." %>
      <button class="btn btn-emerald" type="submit">Search</button>
      <% if @query.present? %>
        <%= link_to "Clear", admin_health_programs_path, class: "btn btn-light border" %>
      <% end %>
    </div>
    <span class="text-secondary small">
      Showing <strong><%= @admin_health_programs.size %></strong> health programs
    </span>
  <% end %>
</div>

<!-- Programs Card Grid -->
<% if @admin_health_programs.any? %>
  <div class="row g-3">
    <% @admin_health_programs.each do |program| %>
      <% announcements_count = program.announcements.count %>
      <div class="col-12 col-md-6 col-xl-4">
        <div class="sa-card p-4 h-100 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div class="sa-icon-well well-emerald">
                <i class="bi bi-heart-pulse-fill"></i>
              </div>
              <span class="badge <%= soft_badge_class(program.status) %>">
                <%= program.status&.titleize || "Active" %>
              </span>
            </div>

            <h5 class="fw-bold text-dark mb-2">
              <%= link_to(program.name.presence || "Untitled Program", [:admin, program], class: "text-dark text-decoration-none") %>
            </h5>
            <p class="text-secondary small mb-3">
              <%= truncate(program.description.presence || "No description provided.", length: 130) %>
            </p>
          </div>

          <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <span class="badge badge-soft-slate">
              <i class="bi bi-megaphone me-1"></i><%= pluralize(announcements_count, "Announcement") %>
            </span>
            <%= link_to [:admin, program], class: "btn btn-sm btn-outline-emerald" do %>
              View Details <i class="bi bi-arrow-right ms-1"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @pagy&.pages.to_i > 1 %>
    <div class="mt-4 d-flex justify-content-end">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
<% else %>
  <div class="sa-card p-5 text-center">
    <div class="sa-icon-well well-slate mx-auto mb-3">
      <i class="bi bi-heart-pulse"></i>
    </div>
    <h5 class="fw-bold mb-1">No Health Programs Found</h5>
    <p class="text-secondary small mb-3">Create a health program to categorize your barangay clinic's services.</p>
    <button type="button" class="btn btn-emerald btn-sm" data-bs-toggle="modal" data-bs-target="#newHealthProgramModal">
      <i class="bi bi-plus-lg me-1"></i>New Health Program
    </button>
  </div>
<% end %>

<%= render "new_modal", admin_health_program: HealthProgram.new %>
