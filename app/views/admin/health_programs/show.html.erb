<% content_for :title, @admin_health_program.name.presence || "Health Program Details" %>

<div class="container py-4">
  <div class="row">
    <div class="col-md-12 mb-4 d-flex justify-content-between align-items-center">
      <h2 class="fw-bold mb-0">
        Health Program Details
        <small class="text-muted">(ID: <%= @admin_health_program.id %>)</small>
      </h2>
      <%= link_to "← Back to List", admin_health_programs_path, class: "btn btn-outline-secondary" %>
    </div>
    <hr class="mb-4">

    <div class="col-md-8">
      <!-- Program Details Card -->
<div class="card mb-4">
  <div class="card-header fw-bold">Program Information</div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-4 text-muted">Program Name</dt>
      <dd class="col-sm-8"><%= @admin_health_program.name.presence || "Untitled Program" %></dd>

      <dt class="col-sm-4 text-muted">Description</dt>
      <dd class="col-sm-8"><%= @admin_health_program.description.presence || "No description provided." %></dd>

      <dt class="col-sm-4 text-muted">Status</dt>
      <dd class="col-sm-8 text-capitalize">
        <%if @admin_health_program.status == "active"%>
          <span class="bg-success text-white px-1 rounded">
          <%= @admin_health_program.status.titleize %>
          </span>
        <% else %>
          <span class="bg-secondary text-white px-1 rounded">
          <%= @admin_health_program.status.titleize %>
          </span>
        <% end %>
      </dd>
    </dl>
  </div>
</div>



      <!-- Health Program Activity Log -->
      <div class="card mb-4">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
          Activity Log
          <button class="btn btn-sm btn-outline-secondary" title="Refresh">
            <i class="bi bi-arrow-clockwise"></i>
          </button>
        </div>

        <div class="card-body">

          <!-- Log Entry: Created -->
          <div class="border-start border-4 ps-3 mb-4 border-primary">
            <div class="fw-semibold">Program created</div>
            <div class="text-muted small">Created by: Admin User</div>
            <div class="text-muted small fst-italic">Initial status: Active</div>
            <div class="text-end text-muted small">Today, 01:10 PM</div>
          </div>

          <!-- Log Entry: Updated -->
          <div class="border-start border-4 ps-3 mb-4 border-primary">
            <div class="fw-semibold">Details updated</div>
            <div class="text-muted small">Changed name and description</div>
            <div class="text-muted small">Updated by: Dr. Santos</div>
            <div class="text-end text-muted small">Today, 02:45 PM</div>
          </div>

          <!-- Log Entry: Status Changed to Inactive -->
          <div class="border-start border-4 ps-3 mb-4 border-primary">
            <div class="fw-semibold">Deactivated</div>
            <div class="text-muted small">Status changed from Active to Inactive</div>
            <div class="text-muted small">Changed by: Admin User</div>
            <div class="text-end text-muted small">Today, 03:30 PM</div>
          </div>

          <!-- Log Entry: Status Changed to Active -->
          <div class="border-start border-4 ps-3 mb-2 border-primary">
            <div class="fw-semibold">Reactivated</div>
            <div class="text-muted small">Status changed from Inactive to Active</div>
            <div class="text-muted small">Changed by: Super Admin</div>
            <div class="text-end text-muted small">Today, 04:00 PM</div>
          </div>

        </div>
      </div>


    </div>

    <div class="col-md-4">
      <!-- Quick Actions -->
      <div class="card mb-4">
        <div class="card-header fw-bold">Quick Actions</div>
        <div class="card-body d-grid gap-2">
          <%= link_to "Edit Program", "#", class: "btn btn-green-600", data: { bs_toggle: "modal", bs_target: "#editHealthProgramModal" } %>

          <%= button_to "Delete Program", [:admin, @admin_health_program], method: :delete,
                data: { confirm: "Are you sure you want to delete this program?" },
                class: "btn btn-outline-danger" %>
        </div>
      </div>

      <!-- Metadata -->
      <div class="card">
        <div class="card-header fw-bold">Metadata</div>
        <div class="card-body">
          <p class="mb-2 text-muted small">Created</p>
          <p><i class="bi bi-calendar-event me-1"></i><%= @admin_health_program.created_at.strftime('%B %d, %Y, %l:%M %p') %></p>

          <p class="mb-2 text-muted small">Last Updated</p>
          <p><i class="bi bi-clock-history me-1"></i><%= @admin_health_program.updated_at.strftime('%B %d, %Y, %l:%M %p') %></p>

          <p class="mb-2 text-muted small">Program ID</p>
          <p><i class="bi bi-fingerprint me-1"></i><%= @admin_health_program.id %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render "edit_modal", admin_health_program: @admin_health_program %>
