<% content_for :title, @admin_health_program.name.presence || "Health Program Details" %>

<div class="container py-4">
  <div class="row mb-3 align-items-center">
    <div class="col-md-8">
      <h2 class="fw-bold mb-0">
        Health Program Details
        <small class="text-muted">(ID: <%= @admin_health_program.id %>)</small>
      </h2>
    </div>
    <div class="col-md-4 text-md-end mt-2 mt-md-0">
      <%= link_to "← Back to List", admin_health_programs_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <!-- LEFT: Program Info + Activity Log -->
    <div class="col-lg-8">
      <!-- Program Info -->
      <div class="card mb-4">
        <div class="card-header fw-bold">Program Information</div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Program Name</dt>
            <dd class="col-sm-8"><%= @admin_health_program.name.presence || "Untitled Program" %></dd>

            <dt class="col-sm-4 text-muted">Description</dt>
            <dd class="col-sm-8"><%= @admin_health_program.description.presence || "No description provided." %></dd>

            <dt class="col-sm-4 text-muted">Status</dt>
            <dd class="col-sm-8 text-capitalize">
              <% if @admin_health_program.status == "active" %>
                <span class="bg-success text-white px-2 rounded small"><%= @admin_health_program.status.titleize %></span>
              <% else %>
                <span class="bg-secondary text-white px-2 rounded small"><%= @admin_health_program.status.titleize %></span>
              <% end %>
            </dd>
          </dl>
        </div>
      </div>

      <!-- Activity Log with Scroll -->
      <div class="card mb-4">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
          <span>Activity Log</span>
          <%= link_to admin_health_program_path(@admin_health_program), class: "btn btn-sm btn-outline-secondary" do %>
            <i class="bi bi-arrow-clockwise"></i> Refresh
          <% end %>
        </div>

        <div class="card-body p-3" style="max-height: 300px; overflow-y: auto;">
          <% if @activity_logs.any? %>
            <% @activity_logs.each do |log| %>
              <div class="border-start border-3 border-primary ps-3 mb-3">
                <div class="d-flex justify-content-between">
                  <strong><%= log.user&.full_name || "System" %></strong>
                  <small class="text-muted"><%= log.created_at.strftime("%b %d, %Y • %I:%M %p") %></small>
                </div>
                <div class="text-dark"><%= log.description&.body&.to_s&.html_safe || "No description available." %></div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted mb-0">No activity logs available for this program.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- RIGHT: Actions + Metadata -->
    <div class="col-lg-4">
      <!-- Quick Actions -->
      <div class="card mb-4">
        <div class="card-header fw-bold">Quick Actions</div>
        <div class="card-body d-grid gap-2">
          <%= link_to "Edit Program", "#", class: "btn btn-success", data: { bs_toggle: "modal", bs_target: "#editHealthProgramModal" } %>
          <%= button_to "Delete Program", [:admin, @admin_health_program], method: :delete,
                data: { confirm: "Are you sure you want to delete this program?" },
                class: "btn btn-outline-danger" %>
        </div>
      </div>

      <!-- Metadata -->
      <div class="card">
        <div class="card-header fw-bold">Metadata</div>
        <div class="card-body small">
          <p class="mb-1 text-muted">Created</p>
          <p><i class="bi bi-calendar-event me-1"></i><%= @admin_health_program.created_at.strftime('%B %d, %Y • %I:%M %p') %></p>

          <p class="mb-1 text-muted">Last Updated</p>
          <p><i class="bi bi-clock-history me-1"></i><%= @admin_health_program.updated_at.strftime('%B %d, %Y • %I:%M %p') %></p>

          <p class="mb-1 text-muted">Program ID</p>
          <p><i class="bi bi-fingerprint me-1"></i><%= @admin_health_program.id %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render "edit_modal", admin_health_program: @admin_health_program %>
