<% content_for :title, @admin_health_program.name.presence || "Health Program Details" %>
<% program_announcements = @admin_health_program.announcements.order(start_date: :desc) %>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <span class="badge <%= soft_badge_class(@admin_health_program.status) %>">
        <%= @admin_health_program.status&.titleize || "Active" %>
      </span>
      <span class="text-secondary small">Program ID #<%= @admin_health_program.id %></span>
    </div>
    <h3 class="fw-bold mb-0"><%= @admin_health_program.name.presence || "Untitled Program" %></h3>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to admin_health_programs_path, class: "btn btn-light border btn-sm" do %>
      <i class="bi bi-arrow-left me-1"></i>Back to Programs
    <% end %>
    <button type="button" class="btn btn-emerald btn-sm" data-bs-toggle="modal" data-bs-target="#editHealthProgramModal">
      <i class="bi bi-pencil me-1"></i>Edit Program
    </button>
  </div>
</div>

<div class="row g-4">
  <!-- Left Column: Program Overview & Linked Service Announcements -->
  <div class="col-12 col-lg-8">
    <div class="sa-card p-4 mb-4">
      <h6 class="fw-bold text-uppercase text-secondary small mb-3" style="letter-spacing: 0.05em;">
        <i class="bi bi-heart-pulse text-success me-1"></i>Program Overview
      </h6>
      <dl class="row mb-0">
        <dt class="col-sm-3 text-secondary small">Program Name</dt>
        <dd class="col-sm-9 fw-semibold text-dark"><%= @admin_health_program.name.presence || "Untitled Program" %></dd>

        <dt class="col-sm-3 text-secondary small">Status</dt>
        <dd class="col-sm-9">
          <span class="badge <%= soft_badge_class(@admin_health_program.status) %>">
            <%= @admin_health_program.status&.titleize || "Active" %>
          </span>
        </dd>

        <dt class="col-sm-3 text-secondary small mb-0">Description</dt>
        <dd class="col-sm-9 text-secondary mb-0" style="line-height: 1.65;">
          <%= @admin_health_program.description.presence || "No description provided." %>
        </dd>
      </dl>
    </div>

    <!-- Real Linked Service Announcements (Replaces fake hardcoded Activity Log!) -->
    <div class="sa-card overflow-hidden">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">
          <i class="bi bi-megaphone-fill text-success me-2"></i>Service Schedules Under This Program (<%= program_announcements.count %>)
        </h6>
        <%= link_to admin_announcements_path(q: { health_program_id_eq: @admin_health_program.id }), class: "btn btn-sm btn-light border" do %>
          View in Announcements
        <% end %>
      </div>

      <% if program_announcements.any? %>
        <div class="table-responsive">
          <table class="table sa-table mb-0">
            <thead>
              <tr>
                <th>Announcement</th>
                <th>Schedule Window</th>
                <th>Booked Capacity</th>
                <th>Status</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% program_announcements.each do |ann| %>
                <tr>
                  <td>
                    <div class="fw-semibold text-dark"><%= ann.name %></div>
                    <small class="text-secondary">#<%= ann.public_uid %> &middot; <%= ann.location %></small>
                  </td>
                  <td class="small">
                    <%= ann.start_date.strftime("%b %d") %> &ndash; <%= ann.end_date.strftime("%b %d, %Y") %>
                  </td>
                  <td class="small fw-semibold">
                    <%= ann.approved_patients_count %> / <%= ann.max_patients %> slots
                  </td>
                  <td>
                    <span class="badge <%= soft_badge_class(ann.status) %>"><%= ann.status.titleize %></span>
                  </td>
                  <td class="text-end">
                    <%= link_to admin_announcement_path(ann.public_uid), class: "btn btn-sm btn-light border" do %>
                      <i class="bi bi-eye"></i> View
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-4 text-center text-secondary small">
          No service announcements have been linked to this health program yet.
        </div>
      <% end %>
    </div>
  </div>

  <!-- Right Column: Quick Actions & Metadata -->
  <div class="col-12 col-lg-4">
    <div class="sa-card p-4 mb-4">
      <h6 class="fw-bold text-uppercase text-secondary small mb-3" style="letter-spacing: 0.05em;">
        Quick Actions
      </h6>
      <div class="d-grid gap-2">
        <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#editHealthProgramModal">
          <i class="bi bi-pencil me-2"></i>Edit Health Program
        </button>

        <%= button_to [:admin, @admin_health_program],
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to delete this health program?" } },
          class: "btn btn-outline-danger w-100" do %>
          <i class="bi bi-trash me-2"></i>Delete Program
        <% end %>
      </div>
    </div>

    <div class="sa-card p-4">
      <h6 class="fw-bold text-uppercase text-secondary small mb-3" style="letter-spacing: 0.05em;">
        Program Metadata
      </h6>
      <div class="d-flex flex-column gap-2 small">
        <div class="d-flex justify-content-between">
          <span class="text-secondary">Program ID</span>
          <code class="fw-semibold text-dark">#<%= @admin_health_program.id %></code>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-secondary">Total Schedules</span>
          <span class="fw-semibold text-dark"><%= program_announcements.count %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-secondary">Created</span>
          <span class="text-dark"><%= @admin_health_program.created_at.strftime("%b %d, %Y") %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-secondary">Last Updated</span>
          <span class="text-dark"><%= @admin_health_program.updated_at.strftime("%b %d, %Y %I:%M %p") %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render "edit_modal", admin_health_program: @admin_health_program %>
