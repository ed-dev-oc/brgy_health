<% content_for :title, "Staff Users" %>

<div class="container mt-4">
  <div class="mb-2">
    <%= render partial: "search_form" %>
 </div>

 <div class="card">
  <div class="card-body">
    
    <% if current_user&.admin? %>
      <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newUserModal">
          <i class="bi bi-plus me-2"></i>
          New Staff User
        </button>
      </div>
    <% end %>

    <caption>Admin Staff Users</caption>
    <div class="table-responsive">
      <table class="table table-hover mt-3">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="users">
          <% @staff_users.each do |user| %>
            <%= render partial: "user", locals: { user: user } %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  </div>
</div>

<% @staff_users.each do |user| %>
  <%= render partial: "user_modal", locals: { user: user } %>
<% end %>

<%= render "new_user_modal", user: User.new %>
