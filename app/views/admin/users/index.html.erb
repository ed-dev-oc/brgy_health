<% content_for :title, "Staff Users" %>

<div class="container mt-4">
  <h1 class="mb-3">Staff Users</h1>

  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end gap-3 mb-3">
    <div class="flex-fill">
      <div class="card">
        <div class="card-body">
          <%= render partial: "search_form" %>
        </div>
      </div>
    </div>

  <%if current_user&.admin?%>
    <div>
      <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newUserModal">
        New Staff User
      </button>
    </div>
    <% end %>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-hover mt-3">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="users">
        <% @staff_users.each do |user| %>
          <%= render partial: "user", locals: { user: user } %>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
</div>

<% @staff_users.each do |user| %>
  <%= render partial: "user_modal", locals: { user: user } %>
<% end %>

<%= render "new_user_modal", user: User.new %>
