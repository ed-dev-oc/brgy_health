<div class="modal fade" id="newUserModal" tabindex="-1" aria-labelledby="newUserModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content shadow-sm rounded-4">
      <%= form_with model: [:admin, user], url: admin_users_path, local: true, html: { class: "needs-validation", novalidate: true } do |f| %>
        <div class="modal-header bg-green-600 text-white rounded-top-4">
          <h5 class="modal-title" id="newUserModalLabel">Add Staff User</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :first_name, class: "form-label" %>
              <%= f.text_field :first_name, class: "form-control", required: true %>
            </div>

            <div class="col-md-6">
              <%= f.label :middle_name, class: "form-label" %>
              <%= f.text_field :middle_name, class: "form-control" %>
            </div>

            <div class="col-md-6">
              <%= f.label :last_name, class: "form-label" %>
              <%= f.text_field :last_name, class: "form-control", required: true %>
            </div>

            <div class="col-md-6">
              <%= f.label :suffix, class: "form-label" %>
              <%= f.text_field :suffix, class: "form-control" %>
            </div>

            <div class="col-md-6">
              <%= f.label :phone_number, class: "form-label" %>
              <%= f.telephone_field :phone_number, class: "form-control" %>
            </div>

            <div class="col-md-6">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control", required: true %>
            </div>

            <div class="col-md-6">
              <%= f.label :password, class: "form-label" %>
              <div class="input-group" data-controller="password-visibility">
                <%= f.password_field :password, autocomplete: "new-password", class: "form-control", data: { password_visibility_target: "passwordInput"}, required: true %>
                <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
                  <i class="bi bi-eye" data-password-visibility-target="icon"></i>
                </button>
              </div>
            </div>

            <div class="col-md-6">
              <%= f.label :password_confirmation, class: "form-label" %>

              <div class="input-group" data-controller="password-visibility">
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", data: { password_visibility_target: "passwordInput"}, required: true %>
                <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
                  <i class="bi bi-eye" data-password-visibility-target="icon"></i>
                </button>
              </div>
            </div>
          </div>

          <%= f.hidden_field :role, value: "staff" %>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Create User", class: "btn btn-green-600" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
