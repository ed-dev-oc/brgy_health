<div class="modal fade" id="newUserModal" tabindex="-1" aria-labelledby="newUserModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <%= form_with model: [:admin, user], url: admin_users_path, local: true, html: { class: "needs-validation", novalidate: true } do |f| %>
        <div class="modal-header border-bottom px-4 py-3">
          <div class="d-flex align-items-center gap-2">
            <span class="sa-icon-well well-emerald" style="width: 36px; height: 36px; font-size: 1rem;">
              <i class="bi bi-person-plus-fill"></i>
            </span>
            <div>
              <h5 class="modal-title fw-bold mb-0" id="newUserModalLabel">Add Barangay Health Worker (Staff)</h5>
              <small class="text-secondary">Create a staff account for Brgy. <%= ActsAsTenant.current_tenant&.name %></small>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :first_name, "First Name *", class: "form-label fw-semibold small" %>
              <%= f.text_field :first_name, class: "form-control", required: true %>
            </div>

            <div class="col-md-6">
              <%= f.label :middle_name, "Middle Name", class: "form-label fw-semibold small" %>
              <%= f.text_field :middle_name, class: "form-control" %>
            </div>

            <div class="col-md-8">
              <%= f.label :last_name, "Last Name *", class: "form-label fw-semibold small" %>
              <%= f.text_field :last_name, class: "form-control", required: true %>
            </div>

            <div class="col-md-4">
              <%= f.label :suffix, "Suffix", class: "form-label fw-semibold small" %>
              <%= f.text_field :suffix, class: "form-control", placeholder: "Jr., R.N., R.M." %>
            </div>

            <div class="col-md-6">
              <%= f.label :phone_number, "Phone Number", class: "form-label fw-semibold small" %>
              <%= f.telephone_field :phone_number, class: "form-control", placeholder: "09XX-XXX-XXXX" %>
            </div>

            <div class="col-md-6">
              <%= f.label :email, "Email Address *", class: "form-label fw-semibold small" %>
              <%= f.email_field :email, class: "form-control", required: true %>
            </div>

            <div class="col-md-6">
              <%= f.label :password, "Password *", class: "form-label fw-semibold small" %>
              <div class="input-group" data-controller="password-visibility">
                <%= f.password_field :password, autocomplete: "new-password", class: "form-control", data: { password_visibility_target: "passwordInput" }, required: true %>
                <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
                  <i class="bi bi-eye" data-password-visibility-target="icon"></i>
                </button>
              </div>
            </div>

            <div class="col-md-6">
              <%= f.label :password_confirmation, "Confirm Password *", class: "form-label fw-semibold small" %>
              <div class="input-group" data-controller="password-visibility">
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", data: { password_visibility_target: "passwordInput" }, required: true %>
                <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
                  <i class="bi bi-eye" data-password-visibility-target="icon"></i>
                </button>
              </div>
            </div>
          </div>

          <%= f.hidden_field :role, value: "staff" %>
        </div>

        <div class="modal-footer bg-light px-4 py-3">
          <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Create Staff Account", class: "btn btn-emerald px-4" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
