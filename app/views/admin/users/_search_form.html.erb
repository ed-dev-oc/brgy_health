<%= search_form_for @q, url: admin_users_path, method: :get, html: { class: "d-flex flex-wrap justify-content-between gap-2" } do |f| %>
  <div class="d-flex align-items-center">
    <div class="input-group" style="min-width: 280px;">
      <span class="input-group-text bg-white border-end-0">
        <i class="bi bi-search"></i>
      </span>
      <%= f.search_field :email_or_first_name_or_last_name_cont,
          class: "form-control border-start-0",
          placeholder: "Search Name" %>
    </div>
  </div>

  <div class="dropdown d-flex align-items-center gap-2">
    <button class="btn btn-outline-green-600 dropdown-toggle" type="button" id="filtersDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="min-width: 150px;">
      <i class="bi bi-filter me-1"></i> Filters
    </button>
    <div class="dropdown-menu p-3 shadow" aria-labelledby="filtersDropdown" style="min-width: 250px;">
      <div class="mb-3">
        <%= label_tag :status, "Status", class: "form-label" %>
        <%= select_tag :status, options_for_select([['All Statuses', ''], ['Active', 'active'], ['Inactive', 'inactive']], params[:status]), class: "form-select" %>
      </div>
      <div class="mb-3">
        <%= label_tag :role, "Role", class: "form-label" %>
        <%= select_tag :role, options_for_select([['All Roles', ''], ['Admin', 'admin'], ['Staff', 'staff'], ['Patient', 'patient']], params[:role]), class: "form-select" %>
      </div>
      <%= submit_tag "Apply Filters", class: "btn btn-green-600 w-100" %>
    </div>
    <%= submit_tag "Search", class: "btn btn-green-600", style: "min-width: 150px;" %>
  </div>
<% end %>
