<% role_options = [['All Roles', ''], ['Admin', 'admin'], ['Staff', 'staff'], ['Patient', 'patient']] %>
<% status_options = [['All Statuses', ''], ['Active', 'active'], ['Inactive', 'inactive']] %>

<div id="users" class="mb-4">
  <%= search_form_for @q, url: admin_users_path, method: :get, html: { class: "row g-3 align-items-end" } do |f| %>
    
    <div class="col-md-4">
      <%= f.label :email_or_first_name_or_last_name_cont, "Search by Name or Email", class: "form-label" %>
      <%= f.search_field :email_or_first_name_or_last_name_cont, class: "form-control", placeholder: "e.g. John or john@email.com" %>
    </div>

    <div class="col-md-3">
      <%= f.label :role, "Filter by Role", class: "form-label" %>
      <%= select_tag :role, options_for_select(role_options, params[:role]), class: "form-select" %>
    </div>

    <div class="col-md-3">
      <%= f.label :status, "Filter by Status", class: "form-label" %>
      <%= select_tag :status, options_for_select(status_options, params[:status]), class: "form-select" %>
    </div>

    <div class="col-md-2 d-grid">
      <%= f.submit "Search", class: "btn btn-primary" %>
    </div>

  <% end %>
</div>
