<tr>
  <td><%= [user.first_name, user.middle_name, user.last_name, user.suffix].compact.join(" ") %></td>
  <td><%= user.email %></td>
  <td><%= user.role.capitalize %></td>
  <td>
    <span class="badge <%= user.flag_list.include?("active") ? "bg-success" : "bg-secondary" %>">
      <%= user.flag_list.include?("active") ? "Active" : "Inactive" %>
    </span>
  </td>
  <td class="d-flex gap-2">
    <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#userModal_<%= user.id %>">
      View
    </button>
    <% if user.flag_list.include?("active") %>
          <%= button_to "Deactivate", toggle_status_admin_user_path(user), method: :patch, data: { confirm: "Are you sure you want to deactivate this user?", turbo: false }, class: "btn btn-danger btn-sm" %>
      <% else %>
          <%= button_to "Activate", toggle_status_admin_user_path(user), method: :patch, data: { confirm: "Are you sure you want to activate this user?", turbo: false }, class: "btn btn-success btn-sm" %>
      <% end %>
  </td>
</tr>
