<% is_active = user.active? %>
<tr>
  <td>
    <div class="d-flex align-items-center gap-2">
      <%= image_tag(profile_url(user), class: "rounded-circle object-fit-cover", size: "36x36") %>
      <div>
        <div class="fw-bold text-dark">
          <%= link_to user.full_name, admin_user_path(user.public_uid), class: "text-dark text-decoration-none" %>
        </div>
        <small class="text-secondary">#<%= user.public_uid %></small>
      </div>
    </div>
  </td>
  <td>
    <div class="small fw-medium text-dark"><%= user.email %></div>
    <small class="text-secondary"><%= user.phone_number.presence || "No phone" %></small>
  </td>
  <td>
    <% if user.subdivision.present? %>
      <span class="badge badge-soft-slate">
        <i class="bi bi-geo-alt me-1"></i><%= user.subdivision.name %>
      </span>
    <% else %>
      <span class="text-secondary small">&mdash;</span>
    <% end %>
  </td>
  <td>
    <span class="badge <%= soft_badge_class(user.role) %>">
      <%= user.role.titleize %>
    </span>
  </td>
  <td>
    <span class="badge <%= is_active ? 'badge-soft-emerald' : 'badge-soft-slate' %>">
      <i class="bi <%= is_active ? 'bi-check-circle-fill' : 'bi-dash-circle' %> me-1"></i><%= is_active ? "Active" : "Inactive" %>
    </span>
  </td>
  <td class="text-end">
    <div class="d-inline-flex align-items-center gap-1">
      <%= link_to admin_user_path(user.public_uid), class: "btn btn-sm btn-light border", title: "View User Profile" do %>
        <i class="bi bi-eye"></i>
      <% end %>

      <% if user.patient? %>
        <%= link_to medical_records_admin_user_path(user.public_uid), class: "btn btn-sm btn-light border text-success", title: "Patient Medical Records (EHR)" do %>
          <i class="bi bi-journal-medical"></i>
        <% end %>
      <% end %>

      <% if current_user&.admin? && user.role == "staff" %>
        <%= link_to edit_admin_user_path(user.public_uid), class: "btn btn-sm btn-light border", title: "Edit Staff User" do %>
          <i class="bi bi-pencil"></i>
        <% end %>
      <% end %>

      <%= button_to toggle_status_admin_user_path(user),
        method: :patch,
        form: { "data-turbo" => "false", class: "d-inline" },
        data: { confirm: "Are you sure you want to #{is_active ? 'deactivate' : 'activate'} #{user.full_name}?" },
        class: "btn btn-sm #{is_active ? 'btn-outline-danger' : 'btn-outline-emerald'}",
        title: is_active ? "Deactivate Account" : "Activate Account" do %>
        <i class="bi <%= is_active ? 'bi-person-slash' : 'bi-person-check' %>"></i>
      <% end %>
    </div>
  </td>
</tr>
