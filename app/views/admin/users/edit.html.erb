<% content_for :title, "Edit User (ID: #{@user.public_uid})" %>

<div class="container mt-4">
  <h1>Edit User</h1>

  <%= form_with model: [:admin, @user], local: true, class: "mt-4" do |f| %>
    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :public_uid, class: "form-label" %>
        <%= f.text_field :public_uid, class: "form-control", readonly: true %>
      </div>

      <div class="col-md-6">
        <%= f.label :first_name, class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :middle_name, class: "form-label" %>
        <%= f.text_field :middle_name, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :last_name, class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :suffix, class: "form-label" %>
        <%= f.text_field :suffix, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :phone_number, class: "form-label" %>
        <%= f.text_field :phone_number, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :role, class: "form-label" %>
        <% if @user.role == "super_admin" %>
            <%= f.text_field :role, value: @user.role.titleize, class: "form-control", readonly: true %>
            <small class="text-muted">Role cannot be changed for Super Admin</small>
        <% else %>
            <%= f.select :role, User.roles.keys.reject { |r| r == "super_admin" }.map { |r| [r.titleize, r] }, {}, class: "form-select" %>
        <% end %>
      </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
      <%= link_to "Back", admin_users_path, class: "btn btn-secondary" %>
      <%= f.submit "Update User", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
