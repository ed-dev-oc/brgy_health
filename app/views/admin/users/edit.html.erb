<% content_for :title, "Edit User — #{@user.full_name}" %>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h3 class="fw-bold mb-1">Edit Staff Account</h3>
    <p class="text-secondary small mb-0">Update personal details and role permissions for <%= @user.full_name %> (#<%= @user.public_uid %>).</p>
  </div>

  <div>
    <%= link_to admin_user_path(@user.public_uid), class: "btn btn-light border btn-sm" do %>
      <i class="bi bi-arrow-left me-1"></i>Back to User
    <% end %>
  </div>
</div>

<div class="sa-card p-4 p-md-5 mx-auto" style="max-width: 760px;">
  <%= form_with model: [:admin, @user], local: true do |f| %>
    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :public_uid, "Public UID", class: "form-label fw-semibold small" %>
        <%= f.text_field :public_uid, class: "form-control bg-light", readonly: true %>
      </div>

      <div class="col-md-6">
        <%= f.label :role, "Account Role", class: "form-label fw-semibold small" %>
        <% if @user.role == "super_admin" %>
          <%= f.text_field :role, value: @user.role.titleize, class: "form-control bg-light", readonly: true %>
        <% else %>
          <%= f.select :role, User.roles.keys.reject { |r| r == "super_admin" }.map { |r| [r.titleize, r] }, {}, class: "form-select" %>
        <% end %>
      </div>

      <div class="col-md-6">
        <%= f.label :first_name, "First Name *", class: "form-label fw-semibold small" %>
        <%= f.text_field :first_name, class: "form-control", required: true %>
      </div>

      <div class="col-md-6">
        <%= f.label :middle_name, "Middle Name", class: "form-label fw-semibold small" %>
        <%= f.text_field :middle_name, class: "form-control" %>
      </div>

      <div class="col-md-8">
        <%= f.label :last_name, "Last Name *", class: "form-label fw-semibold small" %>
        <%= f.text_field :last_name, class: "form-control", required: true %>
      </div>

      <div class="col-md-4">
        <%= f.label :suffix, "Suffix", class: "form-label fw-semibold small" %>
        <%= f.text_field :suffix, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :email, "Email Address *", class: "form-label fw-semibold small" %>
        <%= f.email_field :email, class: "form-control", required: true %>
      </div>

      <div class="col-md-6">
        <%= f.label :phone_number, "Phone Number", class: "form-label fw-semibold small" %>
        <%= f.text_field :phone_number, class: "form-control" %>
      </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
      <%= link_to "Cancel", admin_users_path, class: "btn btn-light border" %>
      <%= f.submit "Save Changes", class: "btn btn-emerald px-4" %>
    </div>
  <% end %>
</div>
