<% content_for :title, "Edit User (ID: #{@user.id})" %>

<div class="container mt-4">
  <h1>Edit User</h1>

  <%= form_with model: [:admin, @user], local: true, class: "mt-4" do |f| %>
    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :public_uid, class: "form-label" %>
        <%= f.text_field :public_uid, class: "form-control", readonly: true %>
      </div>

      <div class="col-md-6">
        <%= f.label :first_name, class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :middle_name, class: "form-label" %>
        <%= f.text_field :middle_name, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :last_name, class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :suffix, class: "form-label" %>
        <%= f.text_field :suffix, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :phone_number, class: "form-label" %>
        <%= f.telephone_field :phone_number, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :role, class: "form-label" %>
        <%= f.select :role, User.roles.keys.map { |r| [r.titleize, r] }, {}, class: "form-select" %>
      </div>

      <div class="col-md-6">
        <%= f.label :barangay_id, class: "form-label" %>
        <%= f.number_field :barangay_id, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= f.label :subdivision_id, class: "form-label" %>
        <%= f.number_field :subdivision_id, class: "form-control" %>
      </div>

      <div class="col-md-12">
        <%= f.label :flags, "Flags (comma-separated)", class: "form-label" %>
        <%= f.text_field :flag_list, value: @user.flag_list.join(', '), class: "form-control" %>
      </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
      <%= link_to "Back", admin_users_path, class: "btn btn-secondary" %>
      <%= f.submit "Update User", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
