<div class="modal fade" id="userModal_<%= user.id %>" tabindex="-1" aria-labelledby="userModalLabel_<%= user.id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="userModalLabel_<%= user.id %>">User Details (ID: <%= user.id %>)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <dl class="row">
          <% {
            "Email" => user.email,
            "Public UID" => user.public_uid,
            "First Name" => user.first_name,
            "Middle Name" => user.middle_name,
            "Last Name" => user.last_name,
            "Suffix" => user.suffix,
            "Phone Number" => user.phone_number,
            "Role" => user.role,
            "Barangay ID" => user.barangay_id,
            "Subdivision ID" => user.subdivision_id,
            "Flags" => user.flag_list.join(", "),
            "Created At" => user.created_at.strftime('%B %d, %Y %l:%M %p'),
            "Updated At" => user.updated_at.strftime('%B %d, %Y %l:%M %p')
          }.each do |label, value| %>
            <dt class="col-sm-4"><%= label %></dt>
            <dd class="col-sm-8"><%= value %></dd>
          <% end %>
        </dl>
      </div>

      <div class="modal-footer d-flex justify-content-between">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

        <div class="d-flex gap-2">
          <%= link_to 'Edit', edit_admin_user_path(user), class: "btn btn-warning btn col-auto" %>
        </div>
      </div>
    </div>
  </div>
</div>
