<div class="container py-4">
  <div class="row">
    <div class="col-md-12 mb-4 d-flex justify-content-between align-items-center">
      <h2 class="fw-bold mb-0">User Details <small class="text-muted">(ID: <%= @user.public_uid %>)</small></h2>
      <%= link_to "← Back to List", admin_users_path, class: "btn btn-outline-secondary" %>
    </div>
    <hr class="mb-4">

    <div class="col-md-8">
      <!-- Profile Card -->
      <div class="card mb-4">
        <div class="card-body d-flex align-items-center">
          <% if @user.profile.present? %>
            <%= display_profile_image(@user) %>
          <% else %>
            <%= image_tag "https://placehold.co/200x200/146c43/white?text=#{@user.initials}", class: "rounded-circle me-3" %>
          <% end %>
          <div>
            <p class="mb-0 fw-semibold"><%= @user.email %></p>
            <small class="text-muted">User Role: <%= @user.role.capitalize %></small>
          </div>
        </div>
      </div>

      <!-- User Information Card -->
      <div class="card mb-4">
        <div class="card-header fw-bold">User Information</div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">First Name</dt>
            <dd class="col-sm-8"><%= @user.first_name %></dd>

            <dt class="col-sm-4 text-muted">Middle Name</dt>
            <dd class="col-sm-8"><%= @user.middle_name || "N/A" %></dd>

            <dt class="col-sm-4 text-muted">Last Name</dt>
            <dd class="col-sm-8"><%= @user.last_name %></dd>

            <dt class="col-sm-4 text-muted">Suffix</dt>
            <dd class="col-sm-8"><%= @user.suffix || "N/A" %></dd>

            <dt class="col-sm-4 text-muted">Phone Number</dt>
            <dd class="col-sm-8"><%= @user.phone_number || "N/A" %></dd>

            <dt class="col-sm-4 text-muted">Role</dt>
            <dd class="col-sm-8"><%= @user.role %></dd>

            <dt class="col-sm-4 text-muted">Barangay</dt>
            <dd class="col-sm-8"><%= @user.barangay&.name || "N/A" %></dd>

            <dt class="col-sm-4 text-muted">Subdivision</dt>
            <dd class="col-sm-8"><%= @user.subdivision&.name || "N/A" %></dd>
          </dl>
        </div>
      </div>

      <!-- Activity Log -->
      <div class="card mb-4">
        <div class="card-header fw-bold">Activity Log</div>
        <div class="card-body">
          <ul class="list-group list-group-flush small">
            <li class="list-group-item">
              <i class="bi bi-pencil-square me-2 text-primary"></i>
              Profile updated
              <small class="text-muted float-end">2 hours ago</small>
            </li>
            <li class="list-group-item">
              <i class="bi bi-calendar-check me-2 text-success"></i>
              Appointment booked
              <small class="text-muted float-end">1 day ago</small>
            </li>
            <li class="list-group-item">
              <i class="bi bi-envelope-open me-2 text-warning"></i>
              Email verified
              <small class="text-muted float-end">3 days ago</small>
            </li>
            <li class="list-group-item">
              <i class="bi bi-shield-lock me-2 text-danger"></i>
              Password changed
              <small class="text-muted float-end">1 week ago</small>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <!-- Quick Actions -->
      <div class="card mb-4">
        <div class="card-header fw-bold">Quick Actions</div>
        <div class="card-body d-grid gap-2">
          <%= link_to "Edit User", edit_admin_user_path(@user.public_uid), class: "btn btn-green-600" %>

          <% if @user.appointments.any? %>
            <%= link_to "View Appointments", admin_appointment_path(@user.appointments.last.public_uid), class: "btn btn-outline-green-600" %>
          <% else %>
            <button class="btn btn-outline-secondary" disabled>No Appointments</button>
          <% end %>

          <a href="#" class="btn btn-outline-green-600">
            <i class="bi bi-journal-medical me-2"></i>
            Medical Records
          </a>
        </div>
      </div>

      <!-- Metadata -->
      <div class="card">
        <div class="card-header fw-bold">Metadata</div>
        <div class="card-body">
          <p class="mb-2 text-muted small">Created</p>
          <p><i class="bi bi-calendar-event me-1"></i><%= @user.created_at.strftime('%B %d, %Y, %l:%M %p') %></p>

          <p class="mb-2 text-muted small">Last Updated</p>
          <p><i class="bi bi-clock-history me-1"></i><%= @user.updated_at.strftime('%B %d, %Y, %l:%M %p') %></p>

          <p class="mb-2 text-muted small">Public UID</p>
          <p><i class="bi bi-fingerprint me-1"></i><%= @user.public_uid %></p>

          <% if @user.flag_list.any? %>
            <p class="mb-2 text-muted small">Flags</p>
            <p><i class="bi bi-flag me-1"></i><%= @user.flag_list.join(", ") %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
