<div class="container py-4">
  <div class="row">
    <div class="col-md-12 mb-4 d-flex justify-content-between align-items-center">
      <h2 class="fw-bold mb-0">
        User Details
        <small class="text-muted">(ID: <%= @user.public_uid %>)</small>
      </h2>
      <%= link_to "← Back to List", admin_users_path, class: "btn btn-outline-secondary" %>
    </div>

    <hr class="mb-4">

    <div class="col-md-8">
      <!-- Profile Card -->
      <div class="card mb-4">
        <div class="card-body d-flex align-items-center">
          <% if @user.profile.present? %>
            <%= display_profile_image(@user) %>
          <% else %>
            <%= image_tag "https://placehold.co/200x200/146c43/white?text=#{@user.initials}", class: "rounded-circle me-3" %>
          <% end %>
          <div>
            <p class="mb-0 fw-semibold"><%= @user.email %></p>
            <small class="text-muted">User Role: <%= @user.role.capitalize %></small>
          </div>
        </div>
      </div>

      <!-- User Information -->
      <div class="card mb-4">
        <div class="card-header fw-bold">User Information</div>
        <div class="card-body">
          <% user_info = {
            "First Name" => @user.first_name,
            "Middle Name" => @user.middle_name || "N/A",
            "Last Name" => @user.last_name,
            "Suffix" => @user.suffix || "N/A",
            "Phone Number" => @user.phone_number || "N/A",
            "Role" => @user.role,
            "Barangay" => @user.barangay&.name || "N/A",
            "Subdivision" => @user.subdivision&.name || "N/A"
          } %>

          <dl class="row mb-0">
            <% user_info.each do |label, value| %>
              <dt class="col-sm-4 text-muted"><%= label %></dt>
              <dd class="col-sm-8"><%= value %></dd>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Activity Log -->
      <div class="card mb-4">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
          Activity Log
          <button class="btn btn-sm btn-outline-secondary" title="Refresh">
            <i class="bi bi-arrow-clockwise"></i>
          </button>
        </div>
        <div class="card-body">
          <% activity_log = [
            { icon: "bi-pencil-square", text: "Profile updated", detail: "Updated by: User", time: "2 hours ago", border: "primary" },
            { icon: "bi-calendar-check", text: "Appointment booked", detail: "Booked by: User", time: "1 day ago", border: "success" },
            { icon: "bi-envelope-open", text: "Email verified", detail: "Verified via confirmation link", time: "3 days ago", border: "warning" },
            { icon: "bi-shield-lock", text: "Password changed", detail: "Changed by: User", time: "1 week ago", border: "danger" }
          ] %>

          <% activity_log.each do |log| %>
            <div class="border-start border-4 ps-3 mb-4 border-<%= log[:border] %>">
              <div class="fw-semibold">
                <i class="bi <%= log[:icon] %> me-2 text-<%= log[:border] %>"></i>
                <%= log[:text] %>
              </div>
              <div class="text-muted small"><%= log[:detail] %></div>
              <div class="text-end text-muted small"><%= log[:time] %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <!-- Quick Actions -->
      <div class="card mb-4">
        <div class="card-header fw-bold">Quick Actions</div>
        <div class="card-body d-grid gap-2">
          <%if current_user&.admin? && @user.role == "staff"%>
          <%= link_to "Edit User", edit_admin_user_path(@user.public_uid), class: "btn btn-green-600" %>
          <% end %>

          <% if @user.appointments.any? %>
            <%= link_to admin_appointment_path(@user.appointments.last.public_uid), class: "btn btn-outline-green-600" do %>
              <i class="bi bi-calendar-check me-2"></i> View Appointments
            <% end %>
          <% else %>
            <button class="btn btn-outline-secondary" disabled>No Appointments</button>
          <% end %>

          <% if @user.appointments.any? %>
            <%= link_to medical_records_admin_user_path(@user.public_uid), class: "btn btn-outline-green-600" do %>
              <i class="bi bi-journal-medical me-2"></i> Medical Records
            <% end %>
          <% else %>
            <button class="btn btn-outline-secondary" disabled>No Medical Records</button>
          <% end %>
        </div>
      </div>

      <!-- Metadata -->
      <div class="card">
        <div class="card-header fw-bold">Metadata</div>
        <div class="card-body">
          <% metadata = {
            "Created" => [@user.created_at, "calendar-event"],
            "Last Updated" => [@user.updated_at, "clock-history"],
            "Public UID" => [@user.public_uid, "fingerprint"]
          } %>

          <% metadata.each do |label, (value, icon)| %>
            <p class="mb-2 text-muted small"><%= label %></p>
            <p><i class="bi bi-<%= icon %> me-1"></i><%= value.is_a?(Time) ? value.strftime('%B %d, %Y, %l:%M %p') : value %></p>
          <% end %>

          <% if @user.flag_list.any? %>
            <p class="mb-2 text-muted small">Flags</p>
            <p><i class="bi bi-flag me-1"></i><%= @user.flag_list.join(", ") %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
