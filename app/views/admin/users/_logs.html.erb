<% if processed_versions.any? %>
  <% processed_versions.each do |log| %>
    <% log[:changes].each do |change| %>
      <div class="d-flex justify-content-between align-items-start">
        <div class="border-start border-4 ps-3 mb-4 border-primary w-100">
          <div class="fw-semibold">
            <i class="bi <%= change[:icon] || 'bi-pencil-square' %> me-2 text-primary"></i>
            <%= change[:message] || "#{change[:field]} updated" %>
          </div>
          <div class="text-muted small">
            <% unless change[:message] %>
              Changed from <strong><%= change[:old] %></strong> to <strong><%= change[:new] %></strong><br>
            <% end %>
            Updated by: <%= change[:who] %>
          </div>
        </div>
        <div class="text-end text-muted small ms-3" style="white-space: nowrap;">
          <%= change[:time].strftime("%B %d, %Y %I:%M %p") %>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <div class="alert alert-info" role="alert">
    <i class="bi bi-info-circle-fill"></i> No activity logs found.
  </div>
<% end %>
