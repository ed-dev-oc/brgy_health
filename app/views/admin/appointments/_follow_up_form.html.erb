<%= form_with(model: appointment, url: follow_up_check_up_admin_appointment_path(parent_appointment.public_uid)) do |form| %>
  <% if appointment.errors.any? %>
    <div class="alert alert-danger rounded-3 small mb-3"><%= appointment.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="mb-3">
    <%= form.label :scheduled_at, "Follow-Up Date & Time *", class: "form-label fw-semibold small" %>
    <%= form.datetime_field :scheduled_at, class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <%= form.label :reason, "Reason for Follow-Up *", class: "form-label fw-semibold small" %>
    <%= form.text_area :reason, rows: 3, class: "form-control", placeholder: "e.g. Second dose vaccination, blood pressure re-evaluation...", required: true %>
  </div>
  <div class="d-flex justify-content-end gap-2 pt-2 border-top">
    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
    <%= form.submit "Schedule Follow-Up", class: "btn btn-emerald px-4" %>
  </div>
<% end %>
