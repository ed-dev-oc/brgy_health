<%= turbo_stream.replace :flash do %>
  <%= render FlashComponent.new(flash: flash) %>
<% end %>

<% if @appointment.errors.any? %>
  <%= turbo_stream.replace :completed_appointment_form,
    partial: "admin/appointments/completed_form",
    locals: { appointment: @appointment } %>
<% else %>
  <%= turbo_stream.action(:redirect, admin_appointment_path(@appointment.public_uid)) %>
<% end %>