<%= form_with(model: appointment, url: flag_as_completed_admin_appointment_path(appointment.public_uid)) do |form| %>
  <% if appointment.errors.any? %>
    <div class="alert alert-danger rounded-3 small mb-3"><%= appointment.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="mb-3">
    <%= form.label :notes, "Clinical Findings & Consultation Notes *", class: "form-label fw-semibold small" %>
    <%= form.text_area :notes, rows: 4, class: "form-control", placeholder: "Record vital signs, assessment, treatment provided, or prescription instructions...", required: true %>
  </div>
  <div class="d-flex justify-content-end gap-2 pt-2 border-top">
    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
    <%= form.submit "Mark as Completed", class: "btn btn-emerald px-4", data: { turbo_confirm: "Mark this consultation as completed?", turbo_submits_with: "Completing..." } %>
  </div>
<% end %>
