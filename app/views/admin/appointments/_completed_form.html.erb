<%= form_with(model: appointment, url: flag_as_completed_admin_appointment_path(appointment.public_uid)) do |form| %>
  <% if appointment.errors.any? %>
    <div class="text-danger"><%= appointment.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="my-2">
    <div class="my-2">
      <%= form.label :notes, class: "form-label" %>
      <%= form.text_area :notes, rows: 3, class: "form-control", required: true %>
    </div>
  </div>
  <div class="my-2">
    <%= form.submit "Complete Appointment", class: "btn btn-primary", data: { turbo_confirm: "Are you sure?", turbo_submits_with: "Completing..."} %>
  </div>
<% end %>