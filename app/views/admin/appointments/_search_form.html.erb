<div class="my-2">
  <%= search_form_for @q, url: admin_appointments_path, class: "d-flex gap-2" do |search_form| %>
    <div class="flex-shrink">
      <div class="input-group">
        <span class="input-group-text" id="basic-addon1">
          <%= search_form.label :patient_full_name_cont do %>
            <i class="bi bi-search"></i>
          <% end %>
        </span>

        <%= search_form.search_field :patient_full_name_cont, class: "form-control", placeholder: "Patient Name Search" %>
      </div>
    </div>

    <div class="flex-fill d-flex gap-2 justify-content-end">
      <div class="dropdown">
        <button type="button" class="btn btn-green-600 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
          <i class="bi bi-filter"></i>
          Filters
        </button>
        <div class="dropdown-menu p-4">
          <div class="my-2">
            <%= search_form.label :announcement_name_cont, "Announcement Name/Title", class: "form-label" %>
            <%= search_form.text_field :announcement_name_cont, class: "form-control" %>
          </div>
          <div class="my-2">
            <%= search_form.label :scheduled_at_gteq, "Scheduled Start", class: "form-label" %>
            <%= search_form.datetime_field :scheduled_at_gteq, class: "form-control" %>
          </div>
          <div class="my-2">
            <%= search_form.label :scheduled_at_lteq, "Scheduled End", class: "form-label" %>
            <%= search_form.datetime_field :scheduled_at_lteq, class: "form-control" %>
          </div>
          <div class="my-2">
            <%= search_form.label :status_eq, "Status", class: "form-label" %>
            <%= search_form.select :status_eq, Appointment.statuses.map { |key, value| [key.titleize, value] }, { include_blank: "All" }, { class: "form-select" } %>
          </div>
          <hr class="dropdown-divider">
          <div class="my-2">
            <%= link_to "Clear Filters", admin_appointments_path, class: "btn btn-primary w-100" %>
          </div>
        </div>
      </div>

      <%= button_tag class: "btn btn-green-600", type: "submit", data: { turbo_submits_with: "Searching..." } do %>
        <i class="bi bi-search"></i>
        Search
      <% end %>
    </div>
  <% end %>
</div>