<div class="modal fade" id="<%= dom_id(@appointment, "modal") %>" tabindex="-1" aria-labelledby="<%= dom_id(@appointment, "modal") %>Label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom px-4 py-3">
        <div class="d-flex align-items-center gap-2">
          <span class="sa-icon-well well-emerald" style="width: 36px; height: 36px; font-size: 1rem;">
            <i class="bi bi-check2-circle"></i>
          </span>
          <div>
            <h5 class="modal-title fw-bold mb-0" id="<%= dom_id(@appointment, "modal") %>Label">Complete Consultation</h5>
            <small class="text-secondary">Record clinical findings &amp; notes for <%= @appointment.patient.full_name %></small>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <%= turbo_frame_tag :completed_appointment_form do %>
          <%= render partial: "admin/appointments/completed_form", locals: { appointment: @appointment } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
