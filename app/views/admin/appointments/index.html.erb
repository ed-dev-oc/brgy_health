<% content_for :title, "Appointments" %>

<%= render partial: "admin/appointments/search_form" %>

<div class="card my-2 rounded-0">
  <div class="card-body">
    <table class="table table-striped align-middle caption-top">
      <caption>List of appointments</caption>
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">Announcement</th>
          <th scope="col">Patient</th>
          <th scope="col">Scheduled</th>
          <th scope="col">Created At</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @appointments.each do |appointment| %>
          <tr>
            <td><%= appointment.public_uid %></td>
            <td><%= appointment.announcement.name %></td>
            <td><%= appointment.patient.full_name %></td>
            <td><%= appointment.scheduled_at.to_formatted_s(:long) %></td>
            <td><%= appointment.created_at.to_formatted_s(:long) %></td>
            <td>
              <div class="dropdown">
                <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  Actions
                </button>
                <ul class="dropdown-menu">
                  <li>
                    <%= link_to admin_appointment_path(appointment.public_uid), class: "dropdown-item" do %>
                      <i class="bi bi-eye"></i>
                      View
                    <% end %>
                  </li>

                  <% if appointment.pending? %>
                    <li>
                      <%= link_to flag_as_approved_admin_appointment_path(appointment.public_uid), data: { turbo_method: :PATCH, turbo_confirm: "Are you sure?"}, class: "dropdown-item text-green-600" do %>
                        <i class="bi bi-check-circle-fill"></i>
                        Approve
                      <% end %>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <%= link_to flag_as_rejected_admin_appointment_path(appointment.public_uid), data: { turbo_method: :PATCH, turbo_confirm: "Are you sure?" }, class: "dropdown-item text-danger" do %>
                        <i class="bi bi-x-circle-fill"></i>
                        Reject
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>