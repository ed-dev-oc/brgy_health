<% testimonial_record = local_assigns[:testimonial] || @testimonial || current_user.testimonial || Testimonial.new %>
<% should_auto_open = local_assigns.fetch(:auto_open, false) %>
<div <%= 'data-controller="admin-testimonial"'.html_safe if should_auto_open %> class="modal fade" id="adminTestimonialModal" tabindex="-1" aria-labelledby="adminTestimonialModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom px-4 py-3">
        <div class="d-flex align-items-center gap-2">
          <span class="sa-icon-well well-emerald" style="width: 36px; height: 36px; font-size: 1rem;">
            <i class="bi bi-chat-heart-fill"></i>
          </span>
          <div>
            <div class="d-flex align-items-center gap-2">
              <h5 class="modal-title fw-bold mb-0" id="adminTestimonialModalLabel">
                <%= testimonial_record.new_record? ? "Share Platform Testimonial" : "Update Platform Testimonial" %>
              </h5>
              <span class="badge bg-light text-secondary border fw-normal">Optional</span>
            </div>
            <small class="text-secondary">Brgy. <%= ActsAsTenant.current_tenant&.name %> Health Center</small>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <%= turbo_frame_tag :adminTestimonial do %>
          <%= render partial: "admin/testimonials/form", locals: { testimonial: testimonial_record } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
