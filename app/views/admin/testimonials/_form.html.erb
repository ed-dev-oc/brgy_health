<%= form_with(model: testimonial, url: testimonial.new_record? ? admin_testimonials_path : admin_testimonial_path(testimonial)) do |form| %>
  <div class="my-2">
    <%= form.label :data, "Testimonial Message", class: "form-label fw-bold" %>
    <%= form.text_area :data, rows: 4, class: "form-control", required: true %>
  </div>
  <div class="my-2">
    <%= form.label :rating, class: "form-label fw-bold" %>
    <%= form.select :rating, Testimonial::RATING.map { |r| [r, r] }, { prompt: "Select a rating" }, { class: "form-select", required: true } %>
  </div>
  <div class="mt-3">
    <%= form.submit class: "btn btn-success", data: { turbo_submits_with: "Submitting...", turbo_confirm: "Are you sure?" } %>
  </div>
<% end %>