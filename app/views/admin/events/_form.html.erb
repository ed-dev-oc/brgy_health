<%= form_with(model: event, url: event.new_record? ? admin_events_path : admin_event_path(event.public_uid), html: { multipart: true }) do |form| %>
  <% if event.errors.any? %>
    <div class="text-danger mb-3">
      <h2><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>

      <ul>
        <% event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <div class="my-2">
      <%= form.label :images, class: "form-label fw-bold" %>
      <%= form.file_field :images, multiple: true, class: "form-control" %>
    </div>
    <div class="my-2">
      <%= form.label :name, class: "form-label fw-bold" %>
      <%= form.text_field :name, class: "form-control", required: true %>
    </div>
    <div class="my-2">
      <%= form.label :start_date, "Start and End Date Time", class: "form-label fw-bold" %>
      <div class="input-group">
        <span class="input-group-text">Schedule</span>
        <%= form.datetime_field :start_date, class: "form-control", required: true %>
        <%= form.datetime_field :end_date, class: "form-control", required: true %>
      </div>
    </div>
    <div class="my-2">
      <%= form.label :audience, class: "form-label fw-bold" %>
      <%= form.select :audience, Event.audiences.map { |key, value| [key.titleize, key] }, { prompt: "Select a audience" }, { class: "form-select", required: true } %>
    </div>
    <div class="my-2">
      <%= form.label :location, class: "form-label fw-bold" %>
      <%= form.text_field :location, class: "form-control", placeholder: "Covered Court, Barangay Health Center, etc...", required: true %>
    </div>
    <div class="my-2">
      <%= form.label :description, class: "form-label fw-bold" %>
      <%= form.rich_text_area :description, class: "form-control", required: true %>
    </div>
    <div class="my-2">
      <%= form.label :status, class: "form-label fw-bold" %>
      <%= form.select :status, Event.statuses.map { |key, value| [key.titleize, key] }, { prompt: "Select a audience" }, { class: "form-select", required: true } %>
    </div>
    <div class="mt-3">
      <%= form.submit class: "btn btn-primary", data: { turbo_submits_with: "Submitting...", turbo_confirm: "Are you sure?" } %>
    </div>
  </div>
<% end %>
