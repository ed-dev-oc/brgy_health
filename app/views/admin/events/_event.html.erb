<div class="modal fade" id="<%= dom_id(event, "modal") %>" tabindex="-1" aria-labelledby="<%= dom_id(event, "modal") %>Label" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h1 class="modal-title fs-5" id="<%= dom_id(event, "modal") %>Label">Event Details</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-7">
            <div class="mb-3">
              <h3 class="fw-bold"><%= event.name %></h3>
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-calendar-event me-2"></i>
                <span><%= event.start_date.to_formatted_s(:long) %> - <%= event.end_date.to_formatted_s(:long) %></span>
              </div>
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-geo-alt me-2"></i>
                <span><%= event.location %></span>
              </div>
              <div class="d-flex align-items-center mb-3">
                <i class="bi bi-people me-2"></i>
                <span><%= event.audience.titleize %></span>
              </div>

              <div class="mb-3">
                <span class="badge <%= badge_status_class(event.status)%>">
                  <%= event.status.titleize %>
                </span>
              </div>
            </div>

            <div class="card mb-4">
              <div class="card-body">
                <h5 class="card-title">Description</h5>
                <p class="card-text">
                  <%= event.description %>
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-5">
            <div class="card">
              <div class="card-header">
                <h5 class="card-title mb-0">Event Images</h5>
              </div>
              <div class="card-body">
                <!-- Main Image Carousel -->
                <div id="<%= dom_id(event, "carouselIndicators") %>" class="carousel slide">
                  <div class="carousel-indicators">
                    <% event.images.each_with_index do |image, index| %>
                      <button type="button" data-bs-target="#<%= dom_id(event, "carouselIndicators") %>" data-bs-slide-to="<%= index %>" class="<%= index == 0 ? "active" : "" %>" aria-current="true" aria-label="Slide <%= index %>"></button>
                    <% end %>
                  </div>
                  <div class="carousel-inner">
                    <% event.images.each_with_index do |image, index| %>
                      <div class="carousel-item <%= index == 0 ? "active" : ""%>">
                        <%= image_tag(image.variant(resize_to_fill: [600, 400]), class: "d-block w-100") %>
                      </div>
                    <% end %>
                  </div>
                  <button class="carousel-control-prev" type="button" data-bs-target="#<%= dom_id(event, "carouselIndicators") %>" data-bs-slide="prev" >
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                  </button>
                  <button class="carousel-control-next" type="button" data-bs-target="#<%= dom_id(event, "carouselIndicators") %>" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                  </button>
                </div>

                <!-- Thumbnail Gallery -->
                <div class="row g-2" id="<%= dom_id(event, "thumbnailGallery") %>">
                  <div class="col-4 d-flex gap-2">
                    <% event.images.each do |image, index| %>
                      <%= image_tag(image.variant(resize_to_fill: [600, 400]), class: "img-thumbnail") %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x"></i>
          Close
        </button>
        <a class="btn btn-primary" href="#" data-bs-toggle="modal" data-bs-target="#<%= dom_id(event, "form_modal") %>">
          <i class="bi bi-pencil"></i>
          Edit
        </a>
      </div>
    </div>
  </div>
</div>
