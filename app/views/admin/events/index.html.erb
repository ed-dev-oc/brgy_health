<%= render partial: "admin/events/search_form" %>

<div class="card my-2 rounded-0">
  <div class="card-body">
    <div class="d-flex justify-content-end">
      <%= link_to "#", class: "btn btn-primary", data: { bs_toggle: "modal", bs_target: "##{ dom_id(@event, "form_modal") }" } do %>
        <i class="bi bi-plus"></i>
        New Event      
      <% end %>

      <%= render partial: "admin/events/form_modal", locals: { event: @event } %>
    </div>
    <table class="table table-striped align-middle caption-top">
      <caption>List of events</caption>
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">EVENT NAME</th>
          <th scope="col">SCHEDULED</th>
          <th scope="col">POSTED BY</th>
          <th scope="col">STATUS</th>
          <th scope="col">ACTIONS</th>
        </tr>
      </thead>
      <tbody class="table-group-divider">
        <% @events.each do |event| %>
          <tr>
            <td><%= event.public_uid %></td>
            <td><%= event.name %></td>
            <td>
              <%= event.start_date.to_formatted_s(:long) %> - <%= event.end_date.to_formatted_s(:long) %>
            </td>
            <td>
              <%= event.posted_by.full_name %>
            </td>
            <td>
              <span class="badge <%= badge_status_class(event.status)%>">
                <%= event.status.titleize %>
              </span>
            </td>
            <td>
              <%= render partial: "admin/events/form_modal", locals: { event: event } %>
              <%= render partial: "admin/events/event", locals: { event: event } %>
              <div class="dropdown">
                <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  Actions
                </button>
                <ul class="dropdown-menu">
                  <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#<%= dom_id(event, "modal") %>">
                      <i class="bi bi-eye"></i>
                      View
                    </a>
                  </li>
                  <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#<%= dom_id(event, "form_modal") %>">
                      <i class="bi bi-pencil"></i>
                      Edit
                    </a>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to archive_admin_event_path(event.public_uid), class: "dropdown-item text-danger", data: { turbo_method: :PATCH, turbo_submits_with: "Submitting...", turbo_confirm: "Are you sure?" } do %>
                      <i class="bi bi-trash"></i>
                      Archive
                    <% end %>
                  </li>
                </ul>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>