<%= form_with(model: announcement, url: announcement.new_record? ? admin_announcements_path : admin_announcement_path(announcement.public_uid), html: { multipart: true } ) do |form| %>
  <% if announcement.errors.any? %>
    <div class="text-danger">
      <h2><%= pluralize(announcement.errors.count, "error") %> prohibited this announcement from being saved:</h2>

      <ul>
        <% announcement.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <div class="my-2">
      <%= form.label :images, class: "form-label fw-bold" %>
      <%= form.file_field :images, multiple: true, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= form.label :name, "Title", class: "form-label fw-bold" %>
      <%= form.text_field :name, required: true, class: "form-control" %>
    </div>
    <div class="my-2">
      <%= form.label :start_date, "Start and End Date Time", class: "form-label fw-bold" %>
      <div class="input-group">
        <span class="input-group-text">Schedule</span>
        <%= form.datetime_field :start_date, class: "form-control", required: true %>
        <%= form.datetime_field :end_date, class: "form-control", required: true %>
      </div>
    </div>
    <div class="my-2">
      <%= form.label :open_time, "Start and End Time", class: "form-label fw-bold" %>
      <div class="input-group">
        <span class="input-group-text">Time</span>
        <%= form.time_field :open_time, required: true, class: "form-control", required: true %>
        <%= form.time_field :close_time, required: true, class: "form-control", required: true %>
      </div>
    </div>
    <div class="mb-3">
      <%= form.label :location, class: "form-label fw-bold" %>
      <%= form.text_field :location, required: true, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= form.label :audience, class: "form-label fw-bold" %>
      <%= form.text_field :audience, placeholder: "All Residents", required: true, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= form.label :max_patients, class: "form-label fw-bold" %>
      <%= form.number_field :max_patients, required: true, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= form.label :status, class: "form-label fw-bold" %>
      <%= form.select :status, 
        options_for_select(Announcement.statuses.map { |key, value| [key.titleize, key] }, announcement.status ), 
        { prompt: "Select a status" }, 
        { class: "form-select", required: true }
      %>
    </div>
    <div class="mb-3">
      <%= form.label :description, class: "form-label fw-bold" %>
      <%= form.rich_text_area :description, class: "overflow-auto", required: true %>
    </div>

    <div class="mb-3" data-controller="nested-attributes-visibility">
      <%= form.label :health_program_id, "Health Program", class: "form-label fw-bold" %>

      <div class="input-group mb-3" data-nested-attributes-visibility-target="selectInputContainer">
        <%= form.collection_select :health_program_id, HealthProgram.all, :id, :name, { include_blank: "Select existing program" }, class: "form-select", required: true %>
        <button type="button" class="btn btn-outline-green-600" data-action="click->nested-attributes-visibility#openForm">
          <i class="bi bi-plus"></i>
          Add New
        </button>
      </div>

      <div class="d-none card rounded-0" data-nested-attributes-visibility-target="nestedFormContainer">
        <div class="card-body">
          <div class="text-end">
            <button type="button" class="btn btn-outline-danger" data-action="click->nested-attributes-visibility#closeForm">
              <i class="bi bi-x"></i>
              Cancel
            </button>
          </div>
          <%= form.fields_for :health_program do |hp_fields| %>
            <div class="mb-3">
              <%= hp_fields.label :name, "New Program Name", class: "form-label fw-bold" %>
              <%= hp_fields.text_field :name, class: "form-control", required: true %>
            </div>
            <div class="mb-3">
              <%= hp_fields.label :description, "New Program Description", class: "form-label fw-bold" %>
              <%= hp_fields.text_area :description, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= hp_fields.label :status, "New Program Status", class: "form-label fw-bold" %>
              <%= hp_fields.select :status, options_for_select(HealthProgram.statuses.keys.map { |s| [s.titleize, s] }), { prompt: "Select status" }, class: "form-select", required: true %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <%= form.submit class: "btn btn-green-600", data: { turbo_submits_with: "Submitting...", turbo_confirm: "Are you sure?"} %>
    </div>
  </div>
<% end %>
