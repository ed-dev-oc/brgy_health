<%= render partial: "admin/announcements/form_modal", locals: { announcement: @announcement } %>

<div class="row">
  <!-- Main Content Column -->
  <div class="col-lg-8">
    <!-- Title and Status Row -->
    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <h1 class="h2 fw-bold mb-2">Community Health Fair</h1>
        <div class="d-flex align-items-center gap-2">
          <span class="badge <%= badge_status_class(@announcement.status) %>">
            <%= @announcement.status.titleize %>
          </span>
        </div>
      </div>
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="announcementActions" data-bs-toggle="dropdown">
          <i class="bi bi-three-dots-vertical"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li>
            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#<%= dom_id(@announcement, "form_modal") %>">
              <i class="bi bi-pencil"></i>
              Edit Announcement
            </a>
          </li>
          <li>
            <%= link_to announcement_path(@announcement.public_uid), class: "dropdown-item" do %>
              <i class="bi bi-eye me-2"></i>View Public Page
            <% end %>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= link_to archive_admin_announcement_path(@announcement.public_uid), class: "dropdown-item text-danger", data: { turbo_method: :PATCH, turbo_submits_with: "Submitting...", turbo_confirm: "Are you sure?" } do %>
              <i class="bi bi-trash"></i>
              Archive
            <% end %>
          </li>
        </ul>
      </div>
    </div>

    <!-- Image Gallery -->
    <div class="card mb-4">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Media</h5>
      </div>
      <div class="card-body" data-controller="splide-loader">
        <div data-splide-loader-target="thumbnailSlides" class="splide" style="padding-top: 1px !important; padding-bottom: 1px !important;">
          <div class="splide__track">
            <ul class="splide__list">
              <% @announcement.images.each do |image| %>
                <li class="splide__slide">
                  <%= image_tag(image.variant(resize_to_fill: [150, 100])) %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Description Card -->
    <div class="card mb-4">
      <div class="card-header bg-white">
        <h5 class="mb-0">Description</h5>
      </div>
      <div class="card-body rich-text-content">
        <%= @announcement.description %>
      </div>
    </div>

    <!-- Event Details Card -->
    <div class="card admin-details-card mb-4">
      <div class="card-header bg-white">
        <h5 class="mb-0">Event Details</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <h6 class="text-muted small mb-1">Start Date & Time</h6>
              <p><i class="bi bi-calendar-event me-2"></i><%= @announcement.start_date.strftime("%B %d, %Y, %I:%M %p") %></p>
            </div>
            <div class="mb-3">
              <h6 class="text-muted small mb-1">Daily Hours</h6>
              <p><i class="bi bi-clock me-2"></i><%= @announcement.open_time.strftime("%I:%M %p") %> - <%= @announcement.close_time.strftime("%I:%M %p") %></p>
            </div>
            <div class="mb-3">
              <h6 class="text-muted small mb-1">Location</h6>
              <p><i class="bi bi-geo-alt me-2"></i><%= @announcement.location %></p>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <h6 class="text-muted small mb-1">End Date</h6>
              <p><i class="bi bi-calendar-event me-2"></i><%= @announcement.end_date.strftime("%B %d, %Y, %I:%M %p") %></p>
            </div>
            <div class="mb-3">
              <h6 class="text-muted small mb-1">Max Participants</h6>
              <p><i class="bi bi-people me-2"></i><%= @announcement.max_patients %></p>
            </div>
            <div class="mb-3">
              <h6 class="text-muted small mb-1">Intended Audience</h6>
              <div class="d-flex flex-wrap gap-1">
                <% @announcement.audience.split(',').each do |audience| %>
                  <span class="badge bg-light text-dark"><%= audience %></span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sidebar Column -->
  <div class="col-lg-4">
    <!-- Quick Actions Card -->
    <div class="card mb-4">
      <div class="card-header bg-white">
        <h5 class="mb-0">Quick Actions</h5>
      </div>
      <div class="card-body">
        <div class="d-grid gap-2 admin-actions">
          <a class="btn btn-primary" href="#" data-bs-toggle="modal" data-bs-target="#<%= dom_id(@announcement, "form_modal") %>">
            <i class="bi bi-pencil"></i>
            Edit Announcement
          </a>

          <%= link_to appointment_details_admin_announcement_path(@announcement.public_uid), class: "btn btn-outline-info" do %>
            <i class="bi bi-calendar-event me-2"></i>View Appointments
          <% end %>

          <%= link_to announcement_path(@announcement.public_uid), class: "btn btn-outline-secondary" do %>
            <i class="bi bi-eye me-2"></i>View Public Page
          <% end %>

          <%= link_to archive_admin_announcement_path(@announcement.public_uid), class: "btn btn-outline-danger", data: { turbo_method: :PATCH, turbo_submits_with: "Submitting...", turbo_confirm: "Are you sure?" } do %>
            <i class="bi bi-trash"></i>
            Archive
          <% end %>
        </div>
      </div>
    </div>

    <!-- Metadata Card -->
    <div class="card metadata-card mb-4">
      <div class="card-header bg-white">
        <h5 class="mb-0">Metadata</h5>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <h6 class="text-muted small mb-1">Created</h6>
          <p><i class="bi bi-calendar-plus me-2"></i><%= @announcement.created_at.strftime("%B %d, %Y, %I:%M %p") %></p>
        </div>
        <div class="mb-3">
          <h6 class="text-muted small mb-1">Last Updated</h6>
          <p><i class="bi bi-calendar-check me-2"></i><%= @announcement.updated_at.strftime("%B %d, %Y, %I:%M %p") %></p>
        </div>
        <div class="mb-3">
          <h6 class="text-muted small mb-1">Created By</h6>
          <p><i class="bi bi-person me-2"></i><%= @announcement.posted_by.full_name %></p>
        </div>
        <div class="mb-3">
          <h6 class="text-muted small mb-1">Barangay</h6>
          <p><i class="bi bi-building me-2"></i><%= @announcement.barangay.full_address %></p>
        </div>
        <div class="mb-3">
          <h6 class="text-muted small mb-1">Health Program</h6>
          <p><i class="bi bi-heart-pulse me-2"></i><%= @announcement.health_program.name %></p>
        </div>
        <div class="mb-3">
          <h6 class="text-muted small mb-1">Public UID</h6>
          <p><i class="bi bi-upc-scan me-2"></i><%= @announcement.public_uid %></p>
        </div>
      </div>
    </div>

    <!-- Activity Log Card -->
    <div class="card mb-4">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Activity Log</h5>
        <button class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>
      <div class="card-body">
        <div class="border-2 border-start border-primary p-1 my-2">
          <div class="d-flex justify-content-between">
            <span class="fw-bold">System</span>
            <small class="fs-6 text-muted">Today, 09:15 AM</small>
          </div>
          <p class="mb-0">Announcement viewed by 5 users</p>
        </div>

        <div class="border-2 border-start border-primary p-1 my-2">
          <div class="d-flex justify-content-between">
            <span class="fw-bold">Juan Dela Cruz</span>
            <small class="fs-6 text-muted">Today, 08:30 AM</small>
          </div>
          <p class="mb-0">Registered for the event</p>
        </div>

        <div class="border-2 border-start border-primary p-1 my-2">
          <div class="d-flex justify-content-between">
            <span class="fw-bold">Maria Santos</span>
            <small class="fs-6 text-muted">Yesterday, 03:45 PM</small>
          </div>
          <p class="mb-0">Updated event description</p>
        </div>

        <div class="border-2 border-start border-primary p-1 my-2">
          <div class="d-flex justify-content-between">
            <span class="fw-bold">System</span>
            <small class="fs-6 text-muted">May 15, 10:45 AM</small>
          </div>
          <p class="mb-0">Status changed from Draft to Published</p>
        </div>

        <div class="border-2 border-start border-primary p-1 my-2">
          <div class="d-flex justify-content-between">
            <span class="fw-bold">Admin User</span>
            <small class="fs-6 text-muted">May 10, 02:30 PM</small>
          </div>
          <p class="mb-0">Created this announcement</p>
        </div>
      </div>
    </div>
  </div>
</div>