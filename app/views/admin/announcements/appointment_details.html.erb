<main>
  <div class="row mb-4">
    <div class="col">
      <h1 class="display-5 fw-bold text-primary">
        <i class="bi bi-calendar-event me-2"></i>Appointment Details
      </h1>
      <p class="lead">View and manage your appointment schedule</p>
    </div>
    <div class="col text-end">
      <%= link_to admin_announcement_path(@announcement.public_uid), class: "btn btn-secondary" do %>
        <i class="bi bi-arrow-left"></i>
        Back
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col">
      <div class="row row-gap-2">
        <div class="col-6">
          <div class="card border-start border-primary border-4 shadow h-100 py-2">
            <div class="card-body">
              <div class="row no-gutters align-items-center">
                <div class="col me-2">
                  <div class="text-xs fw-bold text-primary text-uppercase mb-1">
                    Today's Appointments</div>
                  <div class="h5 mb-0 fw-bold text-gray-800"><%= @announcement.today_appointments_count %></div>
                </div>
                <div class="col-auto">
                  <i class="bi bi-calendar-date fs-2 text-primary"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6">
          <div class="card border-start border-success border-4 shadow h-100 py-2">
            <div class="card-body">
              <div class="row no-gutters align-items-center">
                <div class="col me-2">
                  <div class="text-xs fw-bold text-success text-uppercase mb-1">
                    Available Capacity</div>
                  <div class="h5 mb-0 fw-bold text-gray-800"><%= 100 - @capacity_percentage %>%</div>
                </div>
                <div class="col-auto">
                  <i class="bi bi-people fs-2 text-success"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6">
          <div class="card border-start border-warning border-4 shadow h-100 py-2">
            <div class="card-body">
              <div class="row no-gutters align-items-center">
                <div class="col me-2">
                  <div class="text-xs fw-bold text-warning text-uppercase mb-1">
                    Pending Approvals</div>
                  <div class="h5 mb-0 fw-bold text-gray-800"><%= @announcement.pending_patients_count %></div>
                </div>
                <div class="col-auto">
                  <i class="bi bi-hourglass-split fs-2 text-warning"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6">
          <div class="card border-start border-danger border-4 shadow h-100 py-2">
            <div class="card-body">
              <div class="row no-gutters align-items-center">
                <div class="col me-2">
                  <div class="text-xs fw-bold text-danger text-uppercase mb-1">
                    Cancelled</div>
                  <div class="h5 mb-0 fw-bold text-gray-800"><%= @announcement.canceled_patients_count %></div>
                </div>
                <div class="col-auto">
                  <i class="bi bi-x-circle fs-2 text-danger"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card mb-4 appointment-card">
        <div class="card-header bg-primary text-white">
          <h3 class="card-title mb-0">
            <i class="fas fa-info-circle me-2"></i>Appointment Overview
          </h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <h5 class="fw-bold">Capacity Status</h5>
            <div class="d-flex align-items-center mb-2">
              <span class="me-2">Max Patients:</span>
              <span class="badge bg-primary rounded-pill"><%= @announcement.max_patients %></span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <span class="me-2">Booked Appointments:</span>
              <span class="badge bg-success rounded-pill"><%= @announcement.approved_patients_count %></span>
            </div>
            <div class="progress mt-3">
              <div class="progress-bar bg-success" role="progressbar" style="width: <%= @capacity_percentage %>%" 
                                    aria-valuenow="11" aria-valuemin="0" aria-valuemax="<% @announcement.max_patients %>"></div>
            </div>
            <div class="text-end mt-1">
              <small><%= @capacity_percentage %>% capacity (<%= @announcement.approved_patients_count %>/<%= @announcement.max_patients %>)</small>
            </div>
          </div>
          <div class="alert alert-info mt-4">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Note:</strong> This appointment slot can accommodate up to 
            <span class="fw-bold"><%= @announcement.max_patients %> patients</span> in total.
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4 appointment-card">
    <div class="card-header bg-success text-white">
      <div class="d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
          <i class="fas fa-users me-2"></i>Scheduled Patients (<%= @announcement.approved_patients_count %>)
        </h3>
        <span class="badge bg-white text-success fs-6"><%= @announcement.max_patients - @announcement.approved_patients_count %> slots remaining</span>
      </div>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <%= render partial: "admin/appointments/list_appointment_table" %>
      </div>
    </div>
  </div>
</main>