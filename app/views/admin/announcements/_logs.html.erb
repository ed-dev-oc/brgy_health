<% if logs.present? %>
  <% logs.each do |log| %>

    <% if log.event_type == "update" && log.changeset.present? %>
      
      <% if log.image_updated? %>
        <div class="border-start border-4 ps-3 mb-4 border-primary">
          <div class="fw-semibold d-flex justify-content-between align-items-center">
            <span>Images Updated</span>
            <small class="text-muted"><%= log.timestamp %></small>
          </div>
          <div class="text-muted small">Changed by: <%= log.user_name %></div>
        </div>
      <% end %>

      <% log.changeset.each do |field, (old_val, new_val)| %>
        <% next if ["updated_at", "image_updated_at"].include?(field.to_s) %>
        <div class="border-start border-4 ps-3 mb-4 border-primary">
          <div class="fw-semibold d-flex justify-content-between align-items-center">
            <span><%= log.special_field_label(field) %></span>
            <small class="text-muted"><%= log.timestamp %></small>
          </div>
          <div class="text-muted small"><%= log.field_change_details(field, old_val, new_val) %></div>
          <div class="text-muted small">Changed by: <%= log.user_name %></div>
        </div>
      <% end %>

    <% elsif log.event_type == "create" %>
      <div class="border-start border-4 ps-3 mb-4 border-primary">
        <div class="fw-semibold d-flex justify-content-between align-items-center">
          <span>Announcement Created</span>
          <small class="text-muted"><%= log.timestamp %></small>
        </div>
        <div class="text-muted small">Created by: <%= log.user_name %></div>
      </div>

    <% elsif log.event_type == "view" %>
      <div class="border-start border-4 ps-3 mb-4 border-primary">
        <div class="fw-semibold d-flex justify-content-between align-items-center">
          <span>Announcement Viewed</span>
          <small class="text-muted"><%= log.timestamp %></small>
        </div>
        <div class="text-muted small">Viewed by: <%= log.user_name %></div>
      </div>
    <% end %>

  <% end %>
<% else %>
  <p class="text-muted fst-italic">No activity logs available yet.</p>
<% end %>
