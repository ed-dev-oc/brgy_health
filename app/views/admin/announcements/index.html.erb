<% content_for :title, "Service Announcements — Brgy. #{ActsAsTenant.current_tenant&.name}" %>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h3 class="fw-bold mb-1">Service Announcements &amp; Schedules</h3>
    <p class="text-secondary small mb-0">
      Publish clinic service schedules, configure slot capacities, and export patient attendance reports.
    </p>
  </div>

  <div>
    <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#<%= dom_id(@announcement, 'form_modal') %>">
      <i class="bi bi-plus-lg me-1"></i>New Announcement
    </button>
    <%= render partial: "admin/announcements/form_modal", locals: { announcement: @announcement } %>
  </div>
</div>

<!-- Filter Tabs & Search Form -->
<div class="sa-card p-3 mb-4">
  <% current_status = params.dig(:q, :status_eq).to_s %>
  <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
    <ul class="nav sa-filter-pills bg-light p-1 rounded-3">
      <li class="nav-item">
        <%= link_to "All Schedules", admin_announcements_path, class: "nav-link #{current_status.blank? ? 'active' : ''}" %>
      </li>
      <% Announcement.statuses.each do |status_name, status_val| %>
        <li class="nav-item">
          <%= link_to status_name.titleize, admin_announcements_path(q: { status_eq: status_val }), class: "nav-link #{current_status == status_val.to_s ? 'active' : ''}" %>
        </li>
      <% end %>
    </ul>

    <div class="flex-grow-1" style="max-width: 560px;">
      <%= render partial: "admin/announcements/search_form" %>
    </div>
  </div>
</div>

<!-- Announcements Table Card -->
<div class="sa-card overflow-hidden">
  <% if @announcements.any? %>
    <div class="table-responsive">
      <table class="table sa-table mb-0">
        <thead>
          <tr>
            <th>UID &amp; Service Title</th>
            <th>Health Program</th>
            <th>Schedule Window</th>
            <th>Slot Capacity</th>
            <th>Audience</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @announcements.each do |announcement| %>
            <% pct = announcement.capacity_percentage.round.clamp(0, 100) %>
            <% bar_class = pct >= 90 ? "bg-danger" : (pct >= 70 ? "bg-warning" : "bg-success") %>
            <tr>
              <td>
                <div class="fw-bold text-dark">
                  <%= link_to announcement.name, admin_announcement_path(announcement.public_uid), class: "text-dark text-decoration-none" %>
                </div>
                <small class="text-secondary">
                  #<%= announcement.public_uid %> &middot; <i class="bi bi-geo-alt me-1"></i><%= announcement.location %>
                </small>
              </td>
              <td>
                <% if announcement.health_program.present? %>
                  <span class="badge badge-soft-emerald">
                    <i class="bi bi-heart-pulse me-1"></i><%= announcement.health_program.name %>
                  </span>
                <% else %>
                  <span class="badge badge-soft-slate">General Service</span>
                <% end %>
              </td>
              <td>
                <div class="small fw-semibold text-dark">
                  <%= announcement.start_date.strftime("%b %d") %> &ndash; <%= announcement.end_date.strftime("%b %d, %Y") %>
                </div>
                <small class="text-secondary">
                  <i class="bi bi-clock me-1"></i><%= announcement.open_time.strftime("%I:%M %p") %> &ndash; <%= announcement.close_time.strftime("%I:%M %p") %>
                </small>
              </td>
              <td style="min-width: 150px;">
                <div class="d-flex justify-content-between small mb-1">
                  <span class="fw-semibold text-dark"><%= announcement.approved_patients_count %>/<%= announcement.max_patients %></span>
                  <span class="text-secondary"><%= pct %>%</span>
                </div>
                <div class="progress" style="height: 6px;">
                  <div class="progress-bar <%= bar_class %>" style="width: <%= pct %>%;"></div>
                </div>
              </td>
              <td>
                <div class="d-flex flex-wrap gap-1">
                  <% announcement.audience.to_s.split(",").first(2).each do |aud| %>
                    <span class="badge badge-soft-slate"><%= aud.strip %></span>
                  <% end %>
                </div>
              </td>
              <td>
                <span class="badge <%= soft_badge_class(announcement.status) %>">
                  <%= announcement.status.titleize %>
                </span>
              </td>
              <td class="text-end">
                <%= render partial: "admin/announcements/form_modal", locals: { announcement: announcement } %>
                <div class="d-inline-flex align-items-center gap-1">
                  <%= link_to admin_announcement_path(announcement.public_uid), class: "btn btn-sm btn-light border", title: "View Details" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>
                  <%= link_to appointment_details_admin_announcement_path(announcement.public_uid), class: "btn btn-sm btn-light border text-primary", title: "Slot Roster & Capacity" do %>
                    <i class="bi bi-people"></i>
                  <% end %>
                  <%= link_to admin_announcement_appointment_reports_path(announcement.public_uid, format: :pdf), target: "_blank", class: "btn btn-sm btn-light border text-danger", title: "Export PDF Report" do %>
                    <i class="bi bi-file-earmark-pdf"></i>
                  <% end %>
                  <button type="button" class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#<%= dom_id(announcement, 'form_modal') %>" title="Edit Announcement">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <% unless announcement.archived? %>
                    <%= link_to archive_admin_announcement_path(announcement.public_uid),
                      class: "btn btn-sm btn-outline-danger",
                      title: "Archive",
                      data: { turbo_method: :PATCH, turbo_submits_with: "...", turbo_confirm: "Archive '#{announcement.name}'?" } do %>
                      <i class="bi bi-archive"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="p-3 border-top d-flex justify-content-end">
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>
    <% end %>
  <% else %>
    <div class="p-5 text-center">
      <div class="sa-icon-well well-slate mx-auto mb-3">
        <i class="bi bi-megaphone"></i>
      </div>
      <h5 class="fw-bold mb-1">No Announcements Found</h5>
      <p class="text-secondary small mb-3">Publish a service schedule or health program announcement to start accepting appointments.</p>
      <button type="button" class="btn btn-emerald btn-sm" data-bs-toggle="modal" data-bs-target="#<%= dom_id(@announcement, 'form_modal') %>">
        <i class="bi bi-plus-lg me-1"></i>New Announcement
      </button>
    </div>
  <% end %>
</div>
