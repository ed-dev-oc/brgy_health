<%= turbo_stream.replace :flash do %>
  <%= render FlashComponent.new(flash: flash) %>
<% end %>

<% if @announcement.errors.empty? %>
  <%= turbo_stream.action(:redirect, admin_announcements_path) %>
<% else %>
  <%= turbo_stream.replace dom_id(@announcement, "form"),
    partial: "admin/announcements/form",
    locals: { announcement: @announcement } %>
<% end %>
