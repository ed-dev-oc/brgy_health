<%= turbo_stream_from current_user.notification_channel %>

<%= link_to "#", data: { bs_toggle: "modal", bs_target: "#notificationModal" },
    class: "position-relative btn btn-sm btn-light border rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1",
    title: "Notifications & Alerts" do %>

  <%= turbo_frame_tag :notification_status_frame, src: status_notifications_path(format: :turbo_stream), loading: :lazy do %>
    <i class="bi bi-bell text-success"></i>
  <% end %>
  <span class="small fw-semibold d-none d-sm-inline">Alerts</span>
<% end %>
