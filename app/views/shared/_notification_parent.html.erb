<div>
  <%= turbo_stream_from current_user.notification_channel %>

  <a href="#" class="fs-5 position-relative nav-link p-0" data-bs-toggle="modal" data-bs-target="#notificationModal" aria-controls="notificationOffcanvas">
    <%= turbo_frame_tag :notification_status_frame, src: status_notifications_path(format: :turbo_stream), loading: :lazy do  %>
      <i class="bi bi-bell-fill"></i>
    <% end %>
  </a>
</div>