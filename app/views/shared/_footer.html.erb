<footer class="pub-footer pt-5 pb-4 mt-5">
  <div class="container">
    <div class="row g-4 pb-4 border-bottom border-secondary border-opacity-25">
      <!-- Column 1: Brand & Contact -->
      <div class="col-12 col-lg-4">
        <div class="d-flex align-items-center gap-2 mb-3">
          <span class="pub-brand-icon">
            <i class="bi bi-heart-pulse-fill"></i>
          </span>
          <span class="fs-5 fw-bold text-white">
            <% if ActsAsTenant.current_tenant.present? %>
              Brgy. <%= ActsAsTenant.current_tenant.name %> Health Center
            <% else %>
              BrgyHealth Center
            <% end %>
          </span>
        </div>
        <p class="small text-secondary mb-3">
          Multi-tenant community healthcare management and online appointment scheduling for Philippine Barangays.
        </p>
        <div class="small d-flex flex-column gap-1 text-secondary mb-3">
          <span>
            <i class="bi bi-geo-alt-fill text-success me-2"></i>
            <% if ActsAsTenant.current_tenant.present? %>
              <%= ActsAsTenant.current_tenant.full_address %>
            <% else %>
              Bagong Buhay, Ormoc City, Leyte, 6541
            <% end %>
          </span>
          <span>
            <i class="bi bi-telephone-fill text-success me-2"></i>
            <% if ActsAsTenant.current_tenant.present? %>
              <%= ActsAsTenant.current_tenant.users.admin.first&.phone_number.presence || "0906-172-0165" %>
            <% else %>
              0906-172-0165
            <% end %>
          </span>
          <span>
            <i class="bi bi-envelope-fill text-success me-2"></i>
            <% if ActsAsTenant.current_tenant.present? %>
              <%= ActsAsTenant.current_tenant.users.admin.first&.email.presence || "junjunpojr@gmail.com" %>
            <% else %>
              junjunpojr@gmail.com
            <% end %>
          </span>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <%= image_tag "ph.jpg", alt: "Philippines Flag", size: "26x26", class: "rounded-circle object-fit-cover" %>
          <span class="small fw-semibold text-light">REPUBLIC OF THE PHILIPPINES</span>
        </div>
      </div>

      <!-- Column 2: Quick Links & Issue Report -->
      <div class="col-6 col-lg-3">
        <h6 class="text-white fw-bold text-uppercase small mb-3" style="letter-spacing: 0.05em;">Platform Links</h6>
        <ul class="list-unstyled d-flex flex-column gap-2 small mb-0">
          <li>
            <%= link_to "Home", root_path(subdomain: ActsAsTenant.current_tenant&.subdomain) %>
          </li>
          <% if ActsAsTenant.current_tenant.present? %>
            <li><%= link_to "About Us", about_us_pages_path %></li>
            <li><%= link_to "Contact Us", contact_us_pages_path %></li>
            <li><%= link_to "Announcements", root_path(anchor: "AnnouncementCarousel") %></li>
            <li><%= link_to "Events", root_path(anchor: "EventCarousel") %></li>
          <% else %>
            <li><%= link_to "About Us", main_page_path(:about_us) %></li>
            <li><%= link_to "Contact Us", main_page_path(:contact_us) %></li>
            <li><%= link_to "Privacy Policy", main_page_path(:privacy_policy) %></li>
            <li><%= link_to "Terms of Use", main_page_path(:terms_of_use) %></li>
          <% end %>
          <li class="pt-1">
            <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#reportIssueModal">
              <i class="bi bi-bug-fill me-1"></i>Report System Issue
            </button>
          </li>
        </ul>
      </div>

      <!-- Column 3: National Emergency Hotlines Grid -->
      <div class="col-12 col-lg-5">
        <h6 class="text-white fw-bold text-uppercase small mb-3" style="letter-spacing: 0.05em;">
          <i class="bi bi-telephone-inbound-fill text-danger me-1"></i>National Emergency Hotlines (Philippines)
        </h6>
        <div class="row g-2">
          <div class="col-6">
            <div class="hotline-pill">
              <strong class="text-white d-block">PNP Emergency</strong>
              117 / (02) 8722-0650
            </div>
          </div>
          <div class="col-6">
            <div class="hotline-pill">
              <strong class="text-white d-block">Red Cross</strong>
              143 / (02) 8790-2300
            </div>
          </div>
          <div class="col-6">
            <div class="hotline-pill">
              <strong class="text-white d-block">Bureau of Fire (BFP)</strong>
              (02) 8426-0219
            </div>
          </div>
          <div class="col-6">
            <div class="hotline-pill">
              <strong class="text-white d-block">Mental Health (NCMH)</strong>
              1553 / 0917-899-8727
            </div>
          </div>
          <div class="col-6">
            <div class="hotline-pill">
              <strong class="text-white d-block">NDRRMC / DSWD</strong>
              (02) 8911-5061 / 8931-8101
            </div>
          </div>
          <div class="col-6">
            <div class="hotline-pill">
              <strong class="text-white d-block">Coast Guard / MMDA</strong>
              (02) 8527-8481 / 136
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 small text-secondary">
      <span>&copy; <%= Time.current.year %> Barangay Health Center Platform. All rights reserved.</span>
      <span class="fw-semibold text-light">
        <i class="bi bi-globe-asia-australia text-success me-1"></i>Serving Philippine Communities
      </span>
    </div>
  </div>

  <%= render partial: "issue_reports/modal" %>
</footer>
