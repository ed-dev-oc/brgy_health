<footer class="bg-dark text-light py-3 mt-5">
  <div class="container">
    <div class="row">
      <div class="d-flex flex-column gap-3 col">
        <div class="">
          <%= image_tag "logo.png", alt: "My Logo", size: "50x50", class: "rounded-circle" %>
          <p class="fs-4 fw-bold">Barangay Health Center</p>
        </div>
        <div class="d-flex flex-column">
          <span>
            <i class="bi bi-geo-alt-fill"></i>
            <% if ActsAsTenant.current_tenant.present? %>
              <%= ActsAsTenant.current_tenant.full_address %>
            <% else %>
              Bagong Buhay, Ormoc City, Leyte, 6541
            <% end %>
          </span>
          <span>
            <i class="bi bi-telephone-fill"></i>
            <% if ActsAsTenant.current_tenant.present? %>
              <%= ActsAsTenant.current_tenant.users.admin.first.phone_number %>
            <% else %>
              09061720165
            <% end %>
          </span>
          <span>
            <i class="bi bi-envelope"></i>
            <% if ActsAsTenant.current_tenant.present? %>
              <%= ActsAsTenant.current_tenant.users.admin.first.email %>
            <% else %>
              junjunpojr@gmail.com
            <% end %>
          </span>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <%= image_tag "ph.jpg", alt: "My Logo", size: "30x30", class: "rounded-circle" %>
          <span class="fw-bold">PHILIPPINES</span>
        </div>
      </div>
      <div class="d-flex flex-column col">
        <p class="fs-5 fw-bold">Sections</p>
        <div class="d-flex flex-column">
          <%= link_to "Home", root_path(subdomain: ActsAsTenant.current_tenant&.subdomain), class: "text-light text-decoration-none" %>
          <% if ActsAsTenant.current_tenant.present? %>
            <%= link_to "About Us", about_us_pages_path, class: "text-light text-decoration-none" %>
            <%= link_to "Contact Us", contact_us_pages_path, class: "text-light text-decoration-none" %>
            <%= link_to "Announcements", root_path(anchor: "AnnouncementCarousel"), class: "text-light text-decoration-none" %>
            <%= link_to "Events", root_path(anchor: "EventCarousel"), class: "text-light text-decoration-none" %>
          <% else %>
            <%= link_to "About Us", main_page_path(:about_us), class: "text-light text-decoration-none" %>
            <%= link_to "Contact Us", main_page_path(:contact_us), class: "text-light text-decoration-none" %>
            <%= link_to "Privacy Policy", main_page_path(:privacy_policy), class: "text-light text-decoration-none" %>
            <%= link_to "Terms of Use", main_page_path(:terms_of_use), class: "text-light text-decoration-none" %>
          <% end %>
        </div>
      </div>
      <div class="d-flex flex-column col">
        <p class="fs-5 fw-bold">Emergency Hotline</p>
        <div class="d-flex flex-column">
          <span>
            <i class="bi bi-telephone"></i>
            PNP: 117 or (02) 8722-0650
          </span>
          <span>
            <i class="bi bi-telephone"></i>
            BFP: (02) 8426-0219 or (02) 8426-0246
          </span>
          <span>
            <i class="bi bi-telephone"></i>
            Philippine Red Cross: 143 or (02) 8790-2300
          </span>
          <span>
            <i class="bi bi-telephone"></i>
            NDRRMC: (02) 8911-5061 to 65
          </span>
          <span>
            <i class="bi bi-telephone"></i>
            DSWD: (02) 8931-8101 to 07
          </span>
          <span>
            <i class="bi bi-telephone"></i>
            MMDA: 136 or (02) 8682-4151 to 77
          </span>
          <span>
            <i class="bi bi-telephone"></i>
            Philippine Coast Guard: (02) 8527-8481 to 89
          </span>
          <span>
            <i class="bi bi-telephone"></i>
            NCMH: 1553 or 0917-899-8727
          </span>
        </div>
      </div>
    </div>
    <hr>
    <div class="text-center">
      <p>© 2025 Barangay Health Center, Inc. All rights reserved.</p>
    </div>
  </div>
</footer>