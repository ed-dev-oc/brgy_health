<%
  hero_page = @pages.find(&:homepage_hero_banner?)
  content_pages = @pages.reject(&:homepage_hero_banner?)
%>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Global Platform CMS</h3>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">
      Manage public platform pages, landing hero banner, contact map coordinates, and legal documents.
    </p>
  </div>
  <%= link_to root_path, target: "_blank", rel: "noopener", class: "btn btn-light border d-inline-flex align-items-center gap-1" do %>
    <i class="bi bi-box-arrow-up-right"></i>
    <span>Preview Public Landing Page</span>
  <% end %>
</div>

<!-- Featured Section: Homepage Hero Banner -->
<% if hero_page %>
  <div id="<%= dom_id(hero_page) %>" class="sa-card p-4 mb-4">
    <div class="row g-4 align-items-center">
      <div class="col-12 col-lg-5">
        <% if hero_page.image.attached? %>
          <%= image_tag(hero_page.image, class: "img-fluid rounded-3 border w-100", style: "max-height: 220px; object-fit: cover;", alt: hero_page.title) %>
        <% else %>
          <div class="rounded-3 d-flex align-items-center justify-content-center text-white p-4" style="height: 200px; background: linear-gradient(135deg, #065f46, #0d9488);">
            <div class="text-center">
              <i class="bi bi-image fs-1 d-block mb-1"></i>
              <span class="badge bg-white text-dark">Platform Hero Banner</span>
            </div>
          </div>
        <% end %>
      </div>

      <div class="col-12 col-lg-7">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
          <span class="badge badge-soft-emerald"><i class="bi bi-stars me-1"></i>Featured Landing Section</span>
          <span class="badge badge-soft-slate">Route: <code>/</code></span>
        </div>
        <h4 class="fw-bold mb-2"><%= hero_page.title %></h4>
        <p class="text-secondary mb-3"><%= hero_page.subheadline %></p>

        <div class="d-flex flex-wrap gap-2">
          <button type="button" class="btn btn-emerald" data-bs-toggle="modal" data-bs-target="#<%= dom_id(hero_page, 'modal') %>">
            <i class="bi bi-pencil-square me-1"></i>Edit Hero Banner
          </button>
          <%= link_to main_view_page_helper(hero_page.section), target: "_blank", rel: "noopener", class: "btn btn-light border" do %>
            <i class="bi bi-eye me-1"></i>View Live
          <% end %>
        </div>
      </div>
    </div>
    <%= render partial: "super_admin/cms/form_modal", locals: { page: hero_page } %>
  </div>
<% end %>

<!-- 4 Content & Legal Pages Grid (No "Image Not Applicable" Placeholders) -->
<div class="row g-3">
  <% content_pages.each do |page| %>
    <%
      icon_class, well_class, type_label = case page.section
      when "about_us"
        ["bi-info-circle", "well-emerald", "Rich Text Page"]
      when "contact_us"
        ["bi-geo-alt", "well-sky", "Map & Contact"]
      when "privacy_policy"
        ["bi-shield-lock", "well-amber", "Legal Document"]
      else
        ["bi-file-earmark-text", "well-slate", "Legal Document"]
      end
    %>
    <div class="col-12 col-md-6">
      <div id="<%= dom_id(page) %>" class="sa-card p-4 h-100 d-flex flex-column justify-content-between">
        <div>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
              <div class="sa-icon-well <%= well_class %>"><i class="bi <%= icon_class %>"></i></div>
              <div>
                <h6 class="fw-bold mb-0"><%= page.section.titleize %></h6>
                <small class="text-secondary">Route: <code>/<%= page.section %></code></small>
              </div>
            </div>

            <% if page.contact_us? && page.latitude.present? && page.longitude.present? %>
              <span class="badge badge-soft-sky">
                <i class="bi bi-pin-map me-1"></i><%= page.latitude %>, <%= page.longitude %>
              </span>
            <% else %>
              <span class="badge badge-soft-slate"><%= type_label %></span>
            <% end %>
          </div>

          <p class="fw-semibold text-dark mb-1"><%= page.title %></p>
          <p class="text-secondary small mb-3"><%= page.subheadline %></p>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
          <small class="text-secondary">Updated <%= page.updated_at.strftime("%b %d, %Y") %></small>
          <div class="d-flex gap-2">
            <%= link_to main_view_page_helper(page.section), target: "_blank", rel: "noopener", class: "btn btn-sm btn-light border" do %>
              <i class="bi bi-eye me-1"></i>View Page
            <% end %>
            <button type="button" class="btn btn-sm btn-emerald" data-bs-toggle="modal" data-bs-target="#<%= dom_id(page, 'modal') %>">
              <i class="bi bi-pencil me-1"></i>Edit
            </button>
          </div>
        </div>

        <%= render partial: "super_admin/cms/form_modal", locals: { page: page } %>
      </div>
    </div>
  <% end %>
</div>
