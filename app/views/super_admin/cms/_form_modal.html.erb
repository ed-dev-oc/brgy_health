<div class="modal fade" id="<%= dom_id(page, "modal") %>" tabindex="-1" aria-labelledby="<%= dom_id(page, "modal") %>Label" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 0.9rem;">
      <div class="modal-header border-bottom px-4 py-3">
        <h5 class="modal-title fw-bold mb-0" id="<%= dom_id(page, "modal") %>Label">
          <i class="bi bi-window-stack text-success me-2"></i>Edit <%= page.section.titleize %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <%= form_with(model: page, url: super_admin_cm_path(page), html: { multipart: true }) do |form| %>
          <div class="mb-3">
            <%= form.label :title, "Headline / Page Title", class: "form-label fw-semibold" %>
            <%= form.text_field :title, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :subheadline, "Subheadline / Summary", class: "form-label fw-semibold" %>
            <%= form.textarea :subheadline, rows: 3, class: "form-control", required: true %>
          </div>

          <% unless page.homepage_hero_banner? %>
            <div class="mb-3">
              <%= form.label :content, "Rich Text Page Body", class: "form-label fw-semibold" %>
              <%= form.rich_text_area :content, class: "form-control", required: true %>
            </div>
          <% end %>

          <% if page.homepage_hero_banner? %>
            <div class="mb-3">
              <%= form.label :image, "Hero Banner Image", class: "form-label fw-semibold" %>
              <%= form.file_field :image, class: "form-control", accept: "image/*" %>
            </div>
          <% end %>

          <% if page.contact_us? %>
            <div class="mb-3">
              <%= form.label :latitude, "Map Coordinates (Latitude & Longitude)", class: "form-label fw-semibold" %>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-pin-map text-success me-1"></i>Lat / Lng</span>
                <%= form.number_field :latitude, step: "any", class: "form-control", placeholder: "Latitude (e.g. 14.5995)", required: true %>
                <%= form.number_field :longitude, step: "any", class: "form-control", placeholder: "Longitude (e.g. 120.9842)", required: true %>
              </div>
            </div>
          <% end %>

          <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-4">
            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
            <%= form.submit "Save Changes", class: "btn btn-emerald px-4", data: { turbo_submits_with: "Saving...", turbo_confirm: "Save changes to #{page.section.titleize}?" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
