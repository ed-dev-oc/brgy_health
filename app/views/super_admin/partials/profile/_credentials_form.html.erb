<div class="sa-card p-4">
  <h6 class="fw-bold mb-3"><i class="bi bi-shield-lock-fill text-success me-2"></i>2. Update Login Credentials</h6>

  <%= form_with model: @user, url: profile_path(@user.id), local: true do |form| %>
    <div class="row g-3 mb-3">
      <div class="col-12">
        <%= form.label :email, "Email Address", class: "form-label small fw-semibold" %>
        <%= form.email_field :email, class: "form-control", required: true %>
      </div>

      <div class="col-12 col-md-6">
        <%= form.label :password, "New Password", class: "form-label small fw-semibold" %>
        <div class="input-group" data-controller="password-visibility">
          <%= form.password_field :password, class: "form-control", placeholder: "Leave blank if unchanged", data: { password_visibility_target: "passwordInput" } %>
          <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
            <i class="bi bi-eye" data-password-visibility-target="icon"></i>
          </button>
        </div>
      </div>

      <div class="col-12 col-md-6">
        <%= form.label :password_confirmation, "Password Confirmation", class: "form-label small fw-semibold" %>
        <div class="input-group" data-controller="password-visibility">
          <%= form.password_field :password_confirmation, class: "form-control", placeholder: "Confirm new password", data: { password_visibility_target: "passwordInput" } %>
          <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
            <i class="bi bi-eye" data-password-visibility-target="icon"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="text-end">
      <%= form.submit "Update Credentials", class: "btn btn-outline-emerald px-4" %>
    </div>
  <% end %>
</div>
