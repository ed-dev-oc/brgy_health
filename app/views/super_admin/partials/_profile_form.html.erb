<div class="card">
  <div class="card-body">
    <h5 class="card-title">Update Profile Picture</h5>
    <%= form_with model: @user, url: user_registration_path, local: true, html: { multipart: true } do |form| %>
      <div class="mb-3">
        <%= form.label :profile, class: "form-label" %>
        <%= form.file_field :profile, class: "form-control" %>
      </div>

      <% if @user.profile.attached? %>
        <div class="mb-3">
          <p>Current profile:</p>
          <%= display_profile_image(@user) %>
        </div>
      <% end %>

      <%= form.submit "Update Profile", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
