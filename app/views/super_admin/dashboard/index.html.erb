<!-- Page Header + Quick Actions Toolbar -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Platform Command Center</h3>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">
      Real-time overview of barangay tenants, administrator verifications, and platform health.
    </p>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to super_admin_users_path(filter: "pending_validation"), class: "btn btn-sm btn-emerald d-inline-flex align-items-center gap-2 px-3 py-2" do %>
      <i class="bi bi-person-check-fill"></i>
      <span>Review Pending Admins (<%= @admin_unvalidated %>)</span>
    <% end %>
    <%= link_to super_admin_issue_reports_path(q: { status_eq: IssueReport.statuses[:open] }), class: "btn btn-sm btn-white bg-white border d-inline-flex align-items-center gap-2 px-3 py-2 text-dark" do %>
      <i class="bi bi-bug text-danger"></i>
      <span>Triage Issues</span>
    <% end %>
    <%= link_to super_admin_cms_path, class: "btn btn-sm btn-white bg-white border d-inline-flex align-items-center gap-2 px-3 py-2 text-dark" do %>
      <i class="bi bi-pencil-square text-primary"></i>
      <span>Manage Global CMS</span>
    <% end %>
    <%= link_to "/jobs", target: "_blank", rel: "noopener", class: "btn btn-sm btn-white bg-white border d-inline-flex align-items-center gap-2 px-3 py-2 text-dark" do %>
      <i class="bi bi-cpu text-secondary"></i>
      <span>Background Jobs</span>
    <% end %>
  </div>
</div>

<!-- ==================== ROW 1: 4 ENHANCED KPI SUMMARY CARDS ==================== -->
<div class="row g-3 mb-4">
  <!-- KPI 1: Registered Barangays -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="sa-kpi-card p-3 h-100 d-flex flex-column justify-content-between">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
          <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Registered Barangays</span>
          <div class="fs-2 fw-bold text-dark lh-sm mt-1"><%= @total_tenants %></div>
        </div>
        <div class="sa-icon-well well-emerald">
          <i class="bi bi-buildings"></i>
        </div>
      </div>
      <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="font-size: 0.78rem;">
        <span class="badge badge-soft-emerald rounded-pill px-2 py-1">
          <i class="bi bi-check-circle-fill me-1"></i><%= @verified_tenants_count %> Verified
        </span>
        <span class="text-secondary fw-medium"><%= @unverified_tenants_count %> Unverified</span>
      </div>
    </div>
  </div>

  <!-- KPI 2: Pending Admin Approvals -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="sa-kpi-card p-3 h-100 d-flex flex-column justify-content-between">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
          <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Pending Admin Approvals</span>
          <div class="fs-2 fw-bold text-dark lh-sm mt-1"><%= @admin_unvalidated %></div>
        </div>
        <div class="sa-icon-well well-amber">
          <i class="bi bi-shield-exclamation"></i>
        </div>
      </div>
      <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="font-size: 0.78rem;">
        <% if @admin_unvalidated > 0 %>
          <span class="badge badge-soft-amber rounded-pill px-2 py-1">
            <i class="bi bi-clock-history me-1"></i>Action Needed
          </span>
        <% else %>
          <span class="badge badge-soft-emerald rounded-pill px-2 py-1">
            <i class="bi bi-check2-all me-1"></i>All Verified
          </span>
        <% end %>
        <%= link_to super_admin_users_path(filter: "pending_validation"), class: "text-decoration-none fw-semibold", style: "color: var(--sa-emerald-600);" do %>
          Review queue &rarr;
        <% end %>
      </div>
    </div>
  </div>

  <!-- KPI 3: Open Issue Reports -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="sa-kpi-card p-3 h-100 d-flex flex-column justify-content-between">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
          <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Open Issue Reports</span>
          <div class="fs-2 fw-bold text-dark lh-sm mt-1"><%= @open_reports_count %></div>
        </div>
        <div class="sa-icon-well well-rose">
          <i class="bi bi-exclamation-octagon"></i>
        </div>
      </div>
      <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="font-size: 0.78rem;">
        <% if @critical_reports_count > 0 %>
          <span class="badge badge-soft-rose rounded-pill px-2 py-1">
            <i class="bi bi-fire me-1"></i><%= @critical_reports_count %> Critical
          </span>
        <% else %>
          <span class="badge badge-soft-slate rounded-pill px-2 py-1">0 Critical</span>
        <% end %>
        <span class="text-secondary fw-medium"><%= @total_reports %> Total Logged</span>
      </div>
    </div>
  </div>

  <!-- KPI 4: Active Users & Community Rating -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="sa-kpi-card p-3 h-100 d-flex flex-column justify-content-between">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
          <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Active Platform Users</span>
          <div class="fs-2 fw-bold text-dark lh-sm mt-1"><%= number_with_delimiter(@total_users) %></div>
        </div>
        <div class="sa-icon-well well-sky">
          <i class="bi bi-people"></i>
        </div>
      </div>
      <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="font-size: 0.78rem;">
        <span class="badge badge-soft-sky rounded-pill px-2 py-1">
          <i class="bi bi-star-fill text-warning me-1"></i><%= @average_rating %> Avg (<%= @total_testimonials %>)
        </span>
        <span class="text-secondary fw-medium"><%= @admins_count %> Admins &bull; <%= @staff_count %> Staff</span>
      </div>
    </div>
  </div>
</div>

<!-- ==================== ROW 2: ACTIONABLE QUEUES (APPROVALS + TRIAGE FEED) ==================== -->
<div class="row g-3 mb-4">
  <!-- Left (7 cols): Pending Barangay Admin Approvals Queue -->
  <div class="col-12 col-lg-7">
    <div class="sa-card h-100 d-flex flex-column">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <span class="sa-icon-well well-amber" style="width: 34px; height: 34px; font-size: 1rem;">
            <i class="bi bi-person-Vcard"></i>
          </span>
          <div>
            <h6 class="fw-bold mb-0">Pending Barangay Admin Approvals</h6>
            <small class="text-secondary">Verify newly registered Barangay Administrators to activate their tenant subdomain</small>
          </div>
        </div>
        <%= link_to "View All (#{@admin_unvalidated})", super_admin_users_path(filter: "pending_validation"), class: "btn btn-sm btn-light border fw-medium" %>
      </div>

      <div class="table-responsive flex-grow-1">
        <% if @pending_admins.any? %>
          <table class="table sa-table mb-0">
            <thead>
              <tr>
                <th>Administrator</th>
                <th>Barangay &amp; Location</th>
                <th>Subdomain</th>
                <th>Registered</th>
                <th class="text-end">Quick Action</th>
              </tr>
            </thead>
            <tbody>
              <% @pending_admins.each do |admin| %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div class="sa-avatar well-amber"><%= admin.initials %></div>
                      <div>
                        <div class="fw-semibold text-dark"><%= admin.full_name %></div>
                        <small class="text-secondary"><%= admin.email %></small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% if admin.barangay %>
                      <div class="fw-medium"><%= admin.barangay.name %></div>
                      <small class="text-secondary"><%= admin.barangay.city %>, <%= admin.barangay.province %></small>
                    <% else %>
                      <span class="text-muted">Unassigned</span>
                    <% end %>
                  </td>
                  <td>
                    <% if admin.barangay %>
                      <span class="badge badge-soft-slate font-monospace"><%= admin.barangay.subdomain %></span>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                  <td>
                    <small class="text-secondary"><%= time_ago_in_words(admin.created_at) %> ago</small>
                  </td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-1">
                      <%= link_to validated_super_admin_user_path(admin.public_uid),
                            class: "btn btn-sm btn-emerald",
                            data: {
                              turbo_method: :patch,
                              turbo_confirm: "Approve #{admin.full_name} and verify #{admin.barangay&.name}?",
                              turbo_submits_with: "Approving..."
                            } do %>
                        <i class="bi bi-check-lg"></i> Approve
                      <% end %>
                      <%= link_to super_admin_user_path(admin.public_uid), class: "btn btn-sm btn-light border", title: "Inspect User Details" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="p-5 text-center">
            <div class="sa-icon-well well-emerald mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.6rem;">
              <i class="bi bi-check2-all"></i>
            </div>
            <h6 class="fw-bold mb-1">All Barangay Admins Verified!</h6>
            <p class="text-secondary small mb-0">There are currently no pending administrator registrations awaiting approval.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Right (5 cols): Tabbed Triage Feed (Open Issue Reports & Latest Testimonials) -->
  <div class="col-12 col-lg-5">
    <div class="sa-card h-100 d-flex flex-column">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <ul class="nav sa-filter-pills bg-light p-1 rounded-3" id="triageTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="issues-tab" data-bs-toggle="tab" data-bs-target="#issues-pane" type="button" role="tab">
              <i class="bi bi-bug me-1 text-danger"></i>Issues
              <span class="badge bg-danger ms-1"><%= @open_reports_count %></span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="testimonials-tab" data-bs-toggle="tab" data-bs-target="#testimonials-pane" type="button" role="tab">
              <i class="bi bi-chat-quote me-1 text-primary"></i>Testimonials
              <span class="badge bg-secondary ms-1"><%= @total_testimonials %></span>
            </button>
          </li>
        </ul>
      </div>

      <div class="tab-content flex-grow-1 p-3">
        <!-- Tab 1: Recent Issue Reports -->
        <div class="tab-pane fade show active" id="issues-pane" role="tabpanel">
          <% if @recent_issues.any? %>
            <div class="d-flex flex-column gap-3">
              <% @recent_issues.each do |issue| %>
                <div class="p-3 rounded-3 border bg-light bg-opacity-50 d-flex justify-content-between align-items-start gap-2">
                  <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                      <span class="badge <%= soft_badge_class(issue.priority) %>"><%= issue.priority.titleize %></span>
                      <span class="badge <%= soft_badge_class(issue.issue_type) %>"><%= issue.issue_type.titleize %></span>
                      <small class="text-secondary font-monospace">#<%= issue.public_uid %> &bull; <%= issue.module_area.titleize %></small>
                    </div>
                    <div class="fw-semibold text-dark" style="font-size: 0.88rem;"><%= truncate(issue.title, length: 65) %></div>
                    <small class="text-secondary">Reported by <%= issue.email %> &bull; <%= time_ago_in_words(issue.created_at) %> ago</small>
                  </div>
                  <%= link_to "Triage", super_admin_issue_reports_path(q: { public_uid_eq: issue.public_uid }), class: "btn btn-sm btn-white bg-white border" %>
                </div>
              <% end %>
            </div>
            <div class="mt-3 text-center">
              <%= link_to super_admin_issue_reports_path, class: "text-decoration-none small fw-semibold", style: "color: var(--sa-emerald-600);" do %>
                Open Full Issue Triage Board &rarr;
              <% end %>
            </div>
          <% else %>
            <div class="p-4 text-center text-secondary small">No issue reports logged yet.</div>
          <% end %>
        </div>

        <!-- Tab 2: Latest Testimonials -->
        <div class="tab-pane fade" id="testimonials-pane" role="tabpanel">
          <% if @recent_testimonials.any? %>
            <div class="d-flex flex-column gap-3">
              <% @recent_testimonials.each do |testimonial| %>
                <div class="p-3 rounded-3 border bg-light bg-opacity-50">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="fw-semibold text-dark" style="font-size: 0.88rem;">
                      <%= testimonial.user&.full_name || "Community User" %>
                      <% if testimonial.barangay %>
                        <span class="badge badge-soft-emerald ms-1"><%= testimonial.barangay.name %></span>
                      <% end %>
                    </div>
                    <div class="text-warning" style="font-size: 0.8rem;">
                      <% testimonial.rating.to_i.times do %><i class="bi bi-star-fill"></i><% end %>
                      <% (5 - testimonial.rating.to_i).times do %><i class="bi bi-star"></i><% end %>
                    </div>
                  </div>
                  <p class="text-secondary mb-1" style="font-size: 0.83rem;">
                    "<%= truncate(testimonial.data, length: 110) %>"
                  </p>
                  <small class="text-muted" style="font-size: 0.75rem;">Submitted <%= testimonial.created_at.strftime("%b %d, %Y") %></small>
                </div>
              <% end %>
            </div>
            <div class="mt-3 text-center">
              <%= link_to super_admin_testimonials_path, class: "text-decoration-none small fw-semibold", style: "color: var(--sa-emerald-600);" do %>
                View All Testimonials &rarr;
              <% end %>
            </div>
          <% else %>
            <div class="p-4 text-center text-secondary small">No community testimonials submitted yet.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ==================== ROW 3: ANALYTICS CHARTS ==================== -->
<div class="row g-3">
  <!-- Left (8 cols): Barangay Onboarding Growth -->
  <div class="col-12 col-lg-8">
    <div class="sa-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="fw-bold mb-0">Barangay Tenant Onboarding Growth</h6>
          <small class="text-secondary">Monthly registered barangays on the platform</small>
        </div>
        <span class="badge badge-soft-emerald"><i class="bi bi-graph-up-arrow me-1"></i>Monthly Trend</span>
      </div>
      <div id="tenantMetricsChart" style="height: 280px;">
        <%= line_chart @barangays_by_month, colors: ["#059669"], height: "280px", legend: false %>
      </div>
    </div>
  </div>

  <!-- Right (4 cols): User Distribution by Region -->
  <div class="col-12 col-lg-4">
    <div class="sa-card p-3 h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="fw-bold mb-0">Users by Region</h6>
          <small class="text-secondary">Regional healthcare footprint</small>
        </div>
        <i class="bi bi-geo-alt text-secondary"></i>
      </div>
      <div id="tenantDistributionChart" style="height: 280px;">
        <%= pie_chart @users_per_region, donut: true, colors: ["#059669", "#0d9488", "#0284c7", "#f59e0b", "#6366f1", "#e11d48"], height: "280px" %>
      </div>
    </div>
  </div>
</div>
