<table class="table sa-table mb-0">
  <thead>
    <tr>
      <th>Barangay &amp; Subdomain</th>
      <th>City / Municipality</th>
      <th>Province</th>
      <th>Region</th>
      <th>Verification Status</th>
      <th class="text-end">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if barangays.any? %>
      <% barangays.each do |barangay| %>
        <% is_verified = defined?(verified_barangay_ids) && verified_barangay_ids ? verified_barangay_ids.include?(barangay.id) : barangay.verified? %>
        <tr>
          <td>
            <div class="d-flex align-items-center gap-3">
              <div class="sa-avatar <%= is_verified ? 'well-emerald' : 'well-amber' %>">
                <i class="bi bi-building"></i>
              </div>
              <div>
                <div class="fw-bold text-dark"><%= barangay.name %></div>
                <span class="badge badge-soft-slate font-monospace" style="font-size: 0.7rem;">
                  <i class="bi bi-globe2 me-1"></i><%= barangay.subdomain %>
                </span>
              </div>
            </div>
          </td>
          <td><%= barangay.city %></td>
          <td><%= barangay.province %></td>
          <td><span class="badge badge-soft-slate"><%= barangay.region %></span></td>
          <td>
            <% if is_verified %>
              <span class="badge badge-soft-emerald rounded-pill px-2 py-1">
                <i class="bi bi-check-circle-fill me-1"></i>Verified
              </span>
            <% else %>
              <span class="badge badge-soft-amber rounded-pill px-2 py-1">
                <i class="bi bi-clock-history me-1"></i>Unverified
              </span>
            <% end %>
          </td>
          <td class="text-end">
            <div class="d-inline-flex gap-1">
              <%= link_to super_admin_barangay_path(barangay), class: "btn btn-sm btn-outline-emerald" do %>
                <i class="bi bi-eye me-1"></i>View Details
              <% end %>
              <% if is_verified %>
                <%= link_to root_url(subdomain: barangay.subdomain), target: "_blank", rel: "noopener", class: "btn btn-sm btn-light border", title: "Open Subdomain Portal" do %>
                  <i class="bi bi-box-arrow-up-right"></i>
                <% end %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="6" class="text-center py-5 text-secondary">
          <i class="bi bi-buildings fs-2 d-block mb-2 text-muted"></i>
          No barangays matched your filter criteria.
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
