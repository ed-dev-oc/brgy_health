<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-4">Barangay <%= @barangay.name %></h1>
    <%= link_to "Visit Subdomain Page",
                "http://#{@barangay.subdomain}.lvh.me:3000",
                class: "btn btn-green-600",
                target: "_blank",
                rel: "noopener" %>
  </div>

  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <h5 class="card-title">Location Details</h5>
      <p class="card-text mb-1">
        <strong>Status:</strong>
        <% if @barangay.verified? %>
          <span class="badge bg-primary"><%= @barangay.verified_status %></span>
        <% else %>
          <span class="badge bg-warning text-dark"><%= @barangay.verified_status %></span>
        <% end %>
      </p>
      <p class="card-text mb-1"><strong>Region:</strong> <%= @barangay.region %></p>
      <p class="card-text mb-1"><strong>Province:</strong> <%= @barangay.province %></p>
      <p class="card-text"><strong>City:</strong> <%= @barangay.city %></p>
    </div>
  </div>

  <h3 class="mb-3">Admins & Staff</h3>
  <ul class="list-group mb-4 shadow-sm">
    <% @admins_and_staff.each do |user| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <strong><%= user.email %></strong> (<%= user.role.capitalize %>)
          <% if user.flag_list.include?("require_validation") %>
            <span class="badge bg-warning text-dark ms-2">Needs Validation</span>
          <% end %>
        </div>
        <%= link_to "View Profile", super_admin_user_path(user.public_uid), class: "btn btn-sm btn-outline-green-600" %>
      </li>
    <% end %>
  </ul>

  <div class="mb-4 d-flex justify-content-start">
    <% if @barangay.has_unvalidated_admin? %>
      <%= button_to "Verify Admin", validated_super_admin_user_path(@barangay.unvalidated_admin.public_uid),
            method: :patch,
            data: { confirm: "Are you sure you want to validate this admin?" },
            class: "btn btn-success btn-sm" %>
    <% else %>
      <button class="btn btn-secondary btn-sm" disabled>No admin to validate</button>
    <% end %>
  </div>
</div>
