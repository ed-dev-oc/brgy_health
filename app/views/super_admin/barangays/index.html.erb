<h1 class="mb-4">Barangays</h1>

<%= search_form_for @q, url: super_admin_barangays_path, method: :get, class: "mb-4" do |f| %>
  <div class="input-group w-75">
    <%= f.search_field :name_cont, placeholder: "Search Barangay Name", class: "form-control" %>

    <%= select_tag :status, options_for_select([["All Statuses", ""], ["Verified", "verified"], ["Unverified", "unverified"]], params[:status]), class: "form-select ms-2" %>

    <button class="btn btn-primary ms-2 col-2" type="submit">Filter</button>
  </div>
<% end %>

<table class="table table-striped table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>Name</th>
      <th>City</th>
      <th>Province</th>
      <th>Region</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @barangays.each do |barangay| %>
      <tr>
        <td><%= barangay.name %></td>
        <td><%= barangay.city %></td>
        <td><%= barangay.province %></td>
        <td><%= barangay.region %></td>
        <td>
          <% if barangay.verified? %>
            <span class="badge bg-success"><%= barangay.verified_status %></span>
          <% else %>
            <span class="badge bg-warning text-dark"><%= barangay.verified_status %></span>
          <% end %>
        </td>
        <td>
          <%= link_to "Show", super_admin_barangay_path(barangay), class: "btn btn-sm btn-info" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div>
  <%== pagy_nav(@pagy, link_extra: 'class="page-link"') %>
</div>
