<%= search_form_for q, url: super_admin_barangays_path, method: :get, class: "mb-4 d-flex justify-content-between align-items-start" do |f| %>
  <div class="input-group w-50">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <%= f.search_field :name_cont, placeholder: "Search Barangay Name", class: "form-control" %>
  </div>

  <div class="d-flex align-items-start gap-2">
    <%= render 'filters_dropdown', cities: cities, provinces: provinces, regions: regions %>
    <button class="btn btn-primary" type="submit">Search</button>
  </div>
<% end %>
