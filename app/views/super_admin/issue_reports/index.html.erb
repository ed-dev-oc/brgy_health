<% current_status_eq = params.dig(:q, :status_eq).to_s %>

<!-- Page Header + Segmented Status Filter Pills -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Issue Reports &amp; Triage Board</h3>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">
      Track and resolve platform bug reports, UI/UX feedback, and security tickets submitted by users.
    </p>
  </div>

  <ul class="nav sa-filter-pills bg-white p-1 rounded-3 border">
    <li class="nav-item">
      <%= link_to super_admin_issue_reports_path, class: "nav-link #{current_status_eq.blank? ? 'active' : ''}" do %>
        All <span class="badge badge-soft-slate ms-1"><%= @all_issues_count %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to super_admin_issue_reports_path(q: { status_eq: IssueReport.statuses[:open] }),
            class: "nav-link #{current_status_eq == IssueReport.statuses[:open].to_s ? 'active' : ''}" do %>
        Open <span class="badge badge-soft-amber ms-1"><%= @open_issues_count %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to super_admin_issue_reports_path(q: { status_eq: IssueReport.statuses[:in_progress] }),
            class: "nav-link #{current_status_eq == IssueReport.statuses[:in_progress].to_s ? 'active' : ''}" do %>
        In Progress <span class="badge badge-soft-sky ms-1"><%= @in_progress_issues_count %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to super_admin_issue_reports_path(q: { status_eq: IssueReport.statuses[:resolved] }),
            class: "nav-link #{current_status_eq == IssueReport.statuses[:resolved].to_s ? 'active' : ''}" do %>
        Resolved <span class="badge badge-soft-emerald ms-1"><%= @resolved_issues_count %></span>
      <% end %>
    </li>
  </ul>
</div>

<!-- 4 Quick Triage KPI Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <div class="sa-card p-3 d-flex align-items-center justify-content-between">
      <div>
        <small class="text-secondary fw-semibold">OPEN ISSUES</small>
        <div class="fs-4 fw-bold text-dark"><%= @open_issues_count %></div>
      </div>
      <div class="sa-icon-well well-amber"><i class="bi bi-folder2-open"></i></div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="sa-card p-3 d-flex align-items-center justify-content-between">
      <div>
        <small class="text-secondary fw-semibold">CRITICAL OPEN</small>
        <div class="fs-4 fw-bold text-danger"><%= @critical_issues_count %></div>
      </div>
      <div class="sa-icon-well well-rose"><i class="bi bi-fire"></i></div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="sa-card p-3 d-flex align-items-center justify-content-between">
      <div>
        <small class="text-secondary fw-semibold">IN PROGRESS</small>
        <div class="fs-4 fw-bold text-primary"><%= @in_progress_issues_count %></div>
      </div>
      <div class="sa-icon-well well-sky"><i class="bi bi-gear-wide-connected"></i></div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="sa-card p-3 d-flex align-items-center justify-content-between">
      <div>
        <small class="text-secondary fw-semibold">RESOLVED / CLOSED</small>
        <div class="fs-4 fw-bold text-success"><%= @resolved_issues_count %></div>
      </div>
      <div class="sa-icon-well well-emerald"><i class="bi bi-check2-circle"></i></div>
    </div>
  </div>
</div>

<!-- Multi-Filter Search Bar -->
<div class="sa-card p-3 mb-4">
  <%= search_form_for @q, url: super_admin_issue_reports_path, method: :get do |f| %>
    <div class="row g-2 align-items-center">
      <div class="col-12 col-md-3">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
          <%= f.search_field :title_or_email_cont, class: "form-control border-start-0", placeholder: "Search title or reporter..." %>
        </div>
      </div>

      <div class="col-6 col-md-2">
        <%= f.select :issue_type_eq,
              IssueReport.issue_types.map { |k, v| [k.titleize, v] },
              { include_blank: "All Types" },
              { class: "form-select" } %>
      </div>

      <div class="col-6 col-md-2">
        <%= f.select :priority_eq,
              IssueReport.priorities.map { |k, v| [k.titleize, v] },
              { include_blank: "All Priorities" },
              { class: "form-select" } %>
      </div>

      <div class="col-6 col-md-3">
        <%= f.select :status_eq,
              IssueReport.statuses.map { |k, v| [k.titleize, v] },
              { include_blank: "All Statuses" },
              { class: "form-select" } %>
      </div>

      <div class="col-6 col-md-2 d-flex gap-2">
        <button class="btn btn-emerald flex-grow-1" type="submit">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>
        <%= link_to super_admin_issue_reports_path, class: "btn btn-light border", title: "Reset Filters" do %>
          <i class="bi bi-arrow-counterclockwise"></i>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Issue Reports Table Card -->
<div class="sa-card overflow-hidden">
  <div class="table-responsive" style="min-height: 360px;">
    <table class="table sa-table mb-0">
      <thead>
        <tr>
          <th>Ticket UID</th>
          <th>Title &amp; Module Area</th>
          <th>Type</th>
          <th>Priority</th>
          <th>Status</th>
          <th>Reported By</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @issue_reports.any? %>
          <% @issue_reports.each do |issue_report| %>
            <tr>
              <td><code class="fw-semibold text-dark">#<%= issue_report.public_uid %></code></td>
              <td>
                <div class="fw-semibold text-dark"><%= issue_report.title %></div>
                <span class="badge badge-soft-slate mt-1" style="font-size: 0.7rem;">
                  Module: <%= issue_report.module_area.titleize %>
                </span>
              </td>
              <td>
                <span class="badge <%= soft_badge_class(issue_report.issue_type) %>"><%= issue_report.issue_type.titleize %></span>
              </td>
              <td>
                <span class="badge <%= soft_badge_class(issue_report.priority) %>"><%= issue_report.priority.titleize %></span>
              </td>
              <td>
                <div class="dropdown d-inline-block">
                  <button class="btn btn-sm p-0 border-0 bg-transparent dropdown-toggle d-inline-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="badge <%= soft_badge_class(issue_report.status) %>"><%= issue_report.status.titleize %></span>
                    <i class="bi bi-chevron-down text-secondary" style="font-size: 0.7rem;"></i>
                  </button>
                  <div class="dropdown-menu p-3 shadow border" style="min-width: 220px;">
                    <%= turbo_frame_tag dom_id(issue_report, "status_form") do %>
                      <%= render partial: "super_admin/issue_reports/status_update_form", locals: { issue_report: issue_report } %>
                    <% end %>
                  </div>
                </div>
              </td>
              <td>
                <div class="fw-medium"><%= issue_report.email %></div>
                <small class="text-secondary"><%= issue_report.created_at.strftime("%b %d, %Y &bull; %I:%M %p").html_safe %></small>
              </td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-emerald" data-bs-toggle="modal" data-bs-target="#<%= dom_id(issue_report, "view_modal") %>">
                  <i class="bi bi-eye me-1"></i>Inspect
                </button>
                <%= render partial: "super_admin/issue_reports/view_modal", locals: { issue_report: issue_report } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="text-center py-5 text-secondary">
              <i class="bi bi-check2-circle fs-2 d-block mb-2 text-success"></i>
              No issue reports matched your filter criteria.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="p-3 border-top bg-light bg-opacity-50 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <small class="text-secondary">Showing <strong><%= @pagy.from %>–<%= @pagy.to %></strong> of <strong><%= @pagy.count %></strong> issue reports</small>
      <div>
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>
    </div>
  <% end %>
</div>
