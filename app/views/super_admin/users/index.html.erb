<div class="container">
  <%= render "super_admin/users/search_form" %>

  <div class="card shadow-sm">
    <div class="card-body table-responsive">
      <table class="table table-bordered table-hover align-middle">
        <thead class="table-light text-center">
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Barangay</th>
            <th>Flags</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="text-center"><%= user.public_uid %></td>
              <td><%= user.full_name %></td>
              <td><%= user.email %></td>
              <td><%= user.barangay&.full_address || "—" %></td>
              <td>
                <% user.flag_list.each do |flag| %>
                  <span class="badge bg-primary me-1"><%= flag.titleize %></span>
                <% end %>
              </td>
              <td class="text-center">
                <%= link_to "View", super_admin_user_path(user.public_uid), class: "btn btn-info btn-sm me-1" %>

                <% if user.flag_list.include?("require_validation") %>
                  <%= link_to "Remove Validation", 
                      validated_super_admin_user_path(user.public_uid), 
                      class: "btn btn-danger btn-sm",
                      data: {
                        turbo_method: :PATCH,
                        turbo_confirm: "Are you sure?",
                        turbo_submits_with: "Submitting..."
                      } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="mt-3">
        <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
      </div>
    </div>
  </div>
</div>
