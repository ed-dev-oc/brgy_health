<% current_role_eq = params.dig(:q, :role_eq).to_s %>

<!-- Page Header + Segmented Role & Validation Filter Pills -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1">Users &amp; Administrators Directory</h3>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">
      Inspect user accounts across all barangay tenants and approve pending Barangay Administrators.
    </p>
  </div>

  <ul class="nav sa-filter-pills bg-white p-1 rounded-3 border">
    <li class="nav-item">
      <%= link_to super_admin_users_path,
            class: "nav-link #{params[:filter].blank? && current_role_eq.blank? ? 'active' : ''}" do %>
        All Users <span class="badge badge-soft-slate ms-1"><%= @all_users_count %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to super_admin_users_path(filter: "pending_validation"),
            class: "nav-link #{params[:filter] == 'pending_validation' ? 'active' : ''}" do %>
        Pending Validation <span class="badge badge-soft-amber ms-1"><%= @pending_validation_count %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to super_admin_users_path(q: { role_eq: User.roles[:admin] }),
            class: "nav-link #{current_role_eq == User.roles[:admin].to_s ? 'active' : ''}" do %>
        Admins <span class="badge badge-soft-sky ms-1"><%= @admins_count %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to super_admin_users_path(q: { role_eq: User.roles[:staff] }),
            class: "nav-link #{current_role_eq == User.roles[:staff].to_s ? 'active' : ''}" do %>
        Staff <span class="badge badge-soft-purple ms-1"><%= @staff_count %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to super_admin_users_path(q: { role_eq: User.roles[:patient] }),
            class: "nav-link #{current_role_eq == User.roles[:patient].to_s ? 'active' : ''}" do %>
        Patients <span class="badge badge-soft-emerald ms-1"><%= @patients_count %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to super_admin_users_path(q: { role_eq: User.roles[:platform_staff] }),
            class: "nav-link #{current_role_eq == User.roles[:platform_staff].to_s ? 'active' : ''}" do %>
        Platform Staff <span class="badge badge-soft-purple ms-1"><%= @platform_staff_count %></span>
      <% end %>
    </li>
  </ul>
</div>

<!-- Unified Search & Filter Bar -->
<%= render "super_admin/users/search_form" %>

<!-- Users Table Card -->
<div class="sa-card overflow-hidden">
  <div class="table-responsive">
    <table class="table sa-table mb-0">
      <thead>
        <tr>
          <th>UID</th>
          <th>User &amp; Email</th>
          <th>Role</th>
          <th>Barangay</th>
          <th>Account Flags</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @users.any? %>
          <% @users.each do |user| %>
            <% needs_val = user.flag_list.include?("require_validation") %>
            <tr>
              <td><code class="fw-semibold text-dark">#<%= user.public_uid %></code></td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="sa-avatar <%= needs_val ? 'well-amber' : 'well-sky' %>"><%= user.initials %></div>
                  <div>
                    <div class="fw-semibold text-dark"><%= user.full_name %></div>
                    <small class="text-secondary"><%= user.email %></small>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge <%= soft_badge_class(user.role) %>"><%= user.role.titleize %></span>
              </td>
              <td>
                <% if user.barangay %>
                  <div class="fw-medium"><%= user.barangay.name %></div>
                  <small class="text-secondary"><%= user.barangay.city %>, <%= user.barangay.province %></small>
                <% else %>
                  <span class="text-muted">Platform Global</span>
                <% end %>
              </td>
              <td>
                <% if user.flag_list.any? %>
                  <div class="d-flex flex-wrap gap-1">
                    <% user.flag_list.each do |flag| %>
                      <span class="badge <%= flag == 'require_validation' ? 'badge-soft-amber' : 'badge-soft-slate' %>">
                        <% if flag == "require_validation" %><i class="bi bi-clock-history me-1"></i><% end %>
                        <%= flag.titleize %>
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="badge badge-soft-emerald"><i class="bi bi-check2 me-1"></i>Complete</span>
                <% end %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-1">
                  <% if needs_val %>
                    <%= link_to validated_super_admin_user_path(user.public_uid),
                          class: "btn btn-sm btn-emerald",
                          data: {
                            turbo_method: :patch,
                            turbo_confirm: "Approve #{user.full_name} and remove validation hold?",
                            turbo_submits_with: "Approving..."
                          } do %>
                      <i class="bi bi-check-lg me-1"></i>Approve Admin
                    <% end %>
                  <% end %>

                  <%= link_to super_admin_user_path(user.public_uid), class: "btn btn-sm btn-outline-emerald" do %>
                    <i class="bi bi-eye me-1"></i>View
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center py-5 text-secondary">
              <i class="bi bi-people fs-2 d-block mb-2 text-muted"></i>
              No users matched your search criteria.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="p-3 border-top bg-light bg-opacity-50 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <small class="text-secondary">Showing <strong><%= @pagy.from %>–<%= @pagy.to %></strong> of <strong><%= @pagy.count %></strong> users</small>
      <div>
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>
    </div>
  <% end %>
</div>
