<div class="container mt-4">
  <h2 class="mb-4 text-center text-secondary fw-bold">User Details</h2>

  <div class="card shadow-sm">
    <div class="card-body">
      <div class="row g-3">

        <div class="col-md-6">
          <p><strong>Public ID:</strong> <%= @user.public_uid %></p>
        </div>

        <div class="col-md-6">
          <p><strong>Subdomain Link:</strong>
            <%= link_to root_url(subdomain: @user.barangay&.subdomain), root_path(subdomain: @user.barangay&.subdomain), class: "link-primary" %>
          </p>
        </div>

        <div class="col-md-6">
          <p><strong>Name:</strong> <%= @user.full_name %></p>
        </div>

        <div class="col-md-6">
          <p><strong>Email:</strong> <%= @user.email %></p>
        </div>

        <div class="col-md-6">
          <p><strong>Phone Number:</strong> <%= @user.phone_number || "Not provided" %></p>
        </div>

        <div class="col-md-6">
          <p><strong>Role:</strong> <%= @user.role.titleize %></p>
        </div>

        <div class="col-md-6">
          <p><strong>Barangay:</strong> <%= @user.barangay&.full_address || "Not assigned" %></p>
        </div>

        <div class="col-md-6">
          <p><strong>Subdivision ID:</strong> <%= @user.subdivision_id || "Not assigned" %></p>
        </div>

        <div class="col-md-12">
          <p><strong>Flags:</strong>
            <% if @user.flag_list.present? %>
              <% @user.flag_list.each do |flag| %>
                <span class="badge bg-primary me-1"><%= flag.titleize %></span>
              <% end %>
            <% else %>
              None
            <% end %>
          </p>
        </div>

        <div class="col-md-6">
          <p><strong>Created At:</strong> <%= @user.created_at.strftime("%B %d, %Y %I:%M %p") %></p>
        </div>

        <div class="col-md-6">
          <p><strong>Last Updated:</strong> <%= @user.updated_at.strftime("%B %d, %Y %I:%M %p") %></p>
        </div>

      </div>

      <div class="mt-4">
        <% if @user.flag_list.include?("require_validation") %>
          <%= link_to "Remove Validation",
              validated_super_admin_user_path(@user.public_uid),
              class: "btn btn-danger",
              data: {
                turbo_method: :PATCH,
                turbo_confirm: "Are you sure?",
                turbo_submits_with: "Submitting..."
              } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
