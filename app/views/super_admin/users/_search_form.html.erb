<div class="sa-card p-3 mb-4">
  <%= search_form_for @q, url: super_admin_users_path, method: :get do |f| %>
    <%= hidden_field_tag :filter, params[:filter] if params[:filter].present? %>

    <div class="row g-2 align-items-center">
      <div class="col-12 col-md-4">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
          <%= f.search_field :full_name_or_email_cont, class: "form-control border-start-0", placeholder: "Search full name or email..." %>
        </div>
      </div>

      <div class="col-12 col-sm-6 col-md-3">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-geo-alt"></i></span>
          <%= f.search_field :barangay_name_cont, class: "form-control border-start-0", placeholder: "Filter by Barangay..." %>
        </div>
      </div>

      <div class="col-6 col-sm-6 col-md-3">
        <%= f.select :role_eq,
              options_for_select(User.roles.map { |k, v| [k.titleize, v] }, params.dig(:q, :role_eq)),
              { include_blank: "All User Roles" },
              class: "form-select" %>
      </div>

      <div class="col-6 col-md-2 d-flex gap-2">
        <button class="btn btn-emerald flex-grow-1" type="submit">
          <i class="bi bi-funnel me-1"></i>Search
        </button>
        <%= link_to super_admin_users_path, class: "btn btn-light border", title: "Reset Filters" do %>
          <i class="bi bi-arrow-counterclockwise"></i>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
