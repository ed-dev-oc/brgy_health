
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <%= search_form_for @q, url: super_admin_users_path, html: { class: "d-flex g-2 justify-content-between flex-wrap" } do |f| %>

        <div class="d-flex gap-2">
        <div>
          <div class="input-group" style="min-width: 265px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <%= f.search_field :first_name_cont, class: "form-control", placeholder: "Search First Name" %>
          </div>
        </div>

        <div>
          <div class="input-group" style="min-width: 265px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <%= f.search_field :last_name_cont, class: "form-control", placeholder: "Search Last Name" %>
          </div>
        </div>
        </div>

        <div class="d-flex gap-2">
        <div>
          <div class="dropdown">
            <button class="btn btn-outline-green-600 dropdown-toggle w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="min-width: 150px;">
              <i class="bi bi-filter"></i> Filters
            </button>
            <div class="dropdown-menu p-3" style="min-width: 300px;">

              <div class="mb-3">
                <%= f.label :email_cont, "Email", class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                  <%= f.search_field :email_cont, class: "form-control", placeholder: "Search Email" %>
                </div>
              </div>

              <div class="mb-3">
                <%= f.label :barangay_name_cont, "Barangay", class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                  <%= f.search_field :barangay_name_cont, class: "form-control", placeholder: "Search Barangay Name" %>
                </div>
              </div>

              <div class="d-grid">
                <%= f.submit "Apply Filters", class: "btn btn-green-600" %>
              </div>
            </div>
          </div>
        </div>

        <div>
          <%= f.submit "Search", class: "btn btn-green-600 w-100", style: "min-width: 150px;" %>
        </div>
      <% end %>
      </div>

    </div>
  </div>