<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "#{ActsAsTenant.current_tenant&.name} Admin — BrgyHealth" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="sa-body">
    <%= render partial: "shared/notification_modal" %>
    <% if current_user&.admin? %>
      <%= render partial: "admin/testimonials/form_modal", locals: { testimonial: @sidebar_testimonial || @testimonial || current_user.testimonial || Testimonial.new, auto_open: false } %>
    <% end %>
    <%= render partial: "issue_reports/modal" %>
    <%= render partial: "shared/web_push" %>
    <%= render(FlashComponent.new(flash: flash)) %>

    <div class="sa-wrapper">
      <%= render partial: "admin/shared/sidebar" %>

      <div class="sa-main">
        <%= render partial: "admin/shared/topbar" %>

        <main class="container-fluid p-3 p-lg-4 flex-grow-1">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
