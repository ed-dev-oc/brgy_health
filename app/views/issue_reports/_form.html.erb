<%= form_with(model: issue_report, url: issue_reports_path, html: { multipart: true }, data: { controller: "issue-report" }) do |form| %>
  <% if issue_report.errors.any? %>
    <div class="text-danger">
      <h2><%= pluralize(issue_report.errors.count, "error") %> prohibited this Issue Report from being saved:</h2>

      <ul>
        <% issue_report.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="d-flex flex-column">
    <div class="mb-3">
      <h6 class="mb-4 text-muted">
        <i class="bi bi-tag-fill me-2"></i>
        Issue Type
      </h6>

      <div class="row g-3">
        <div class="col-md-6">
          <%= form.radio_button :issue_type, :bug, class: "d-none" %>

          <div class="card issue-type-card p-3" data-type="issue_report_issue_type_bug" data-action="click->issue-report#issueTypeSelected">
            <div class="d-flex align-items-center">
              <div class="bg-danger bg-opacity-10 p-2 rounded me-3">
                <i class="bi bi-bug-fill text-danger fs-4"></i>
              </div>
              <div>
                <h6 class="mb-0">Bug Report</h6>
                <small class="text-muted">Something isn't working as expected</small>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <%= form.radio_button :issue_type, :feature_request, class: "d-none" %>

          <div class="card issue-type-card p-3" data-type="issue_report_issue_type_feature_request" data-action="click->issue-report#issueTypeSelected">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
                <i class="bi bi-lightbulb-fill text-primary fs-4"></i>
              </div>
              <div>
                <h6 class="mb-0">Feature Request</h6>
                <small class="text-muted">Suggest an improvement or new feature</small>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <%= form.radio_button :issue_type, :ui_ux, class: "d-none" %>

          <div class="card issue-type-card p-3" data-type="issue_report_issue_type_ui_ux" data-action="click->issue-report#issueTypeSelected">
            <div class="d-flex align-items-center">
              <div class="bg-info bg-opacity-10 p-2 rounded me-3">
                <i class="bi bi-brush-fill text-info fs-4"></i>
              </div>
              <div>
                <h6 class="mb-0">UI/UX Issue</h6>
                <small class="text-muted">Problem with design or user experience</small>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <%= form.radio_button :issue_type, :security, class: "d-none" %>

          <div class="card issue-type-card p-3" data-type="issue_report_issue_type_security" data-action="click->issue-report#issueTypeSelected">
            <div class="d-flex align-items-center">
              <div class="bg-warning bg-opacity-10 p-2 rounded me-3">
                <i class="bi bi-shield-shaded text-warning fs-4"></i>
              </div>
              <div>
                <h6 class="mb-0">Security Concern</h6>
                <small class="text-muted">Report a potential security vulnerability</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <hr>

    <div class="mb-3">
      <h6 class="mb-4 text-muted">
        <i class="bi bi-info-circle-fill me-2"></i>
        Basic Information 
      </h6>

      <div class="mb-3">
        <%= form.label :title, class: "form-label" %>
        <%= form.text_field :title, class: "form-control", placeholder: "Briefly describe the issue", required: true %>
      </div>

      <div class="mb-3">
        <%= form.label :description, class: "form-label" %>
        <%= form.text_area :description, class: "form-control", rows: 5, placeholder: "Please provide detailed information about the issue...", required: true %>
        <div class="form-text">Include steps to reproduce, expected behavior, and actual behavior.</div>
      </div>
    </div>

    <hr>

    <div class="mb-3">
      <h6 class="mb-4 text-muted">
        <i class="bi bi-three-dots me-2"></i>
        Addition Details 
      </h6>

      <div class="row mb-3">
        <div class="col-md-6">
          <%= form.label :priority, class: "form-label" %>
          <%= form.select :priority, IssueReport.priorities.map { |key, value| [key.titleize, key] }, { prompt: "Select priority" }, { class: "form-select", required: true } %>
        </div>
        <div class="col-md-6">
          <%= form.label :module_area, "Module/Area", class: "form-label" %>
          <%= form.select :module_area, IssueReport.module_areas.map { |key, value| [key.titleize, key] }, { prompt: "Select affected area" }, { class: "form-select", required: true } %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :url, class: "form-label" %>
        <%= form.text_field :url, class: "form-control", placeholder: "https://example.com/page" %>
      </div>

      <div class="mb-3">
        <%= form.label :images, "Screenshot (if applicable)", class: "form-label" %>
        <%= form.file_field :images, multiple: true, class: "form-control" %>
      </div>
    </div>

    <hr>

    <div class="mb-3">
      <h6 class="mb-4 text-muted">
        <i class="bi bi-person-fill"></i>
        Your Information 
      </h6>

      <div class="mb-3">
        <%= form.label :email, "Your Email (for follow-up)", class: "form-label" %>
        <%= form.email_field :email, class: "form-control", placeholder: "your@email.com", required: true %>
      </div>
    </div>

    <div class="text-end border-top pt-4">
      <button type="submit" class="btn btn-primary" data-turbo-submits-with="Submitting...">
        <i class="bi bi-send-fill"></i>
        Submit Report
      </button>
    </div>
  </div>
<% end %>
