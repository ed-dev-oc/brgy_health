<div class="container py-5">
  <div class="row justify-content-center align-items-center min-vh-100">
    <div class="col-lg-12 col-md-10 col-sm-12">
      <div class="card shadow border-0 rounded-4 overflow-hidden" style="max-height: 90vh;">
        <div class="row g-0">
          <div class="col-md-6 p-5 bg-white">
            <div class="text-center mb-4">
              <%= image_tag 'logo_no_background.png', alt: 'BHC Logo', class: 'img-fluid', style: 'height: 80px;' %>
            </div>

            <% if ActsAsTenant.current_tenant.present? %>
              <h3 class="text-center mb-3">Barangay <%= ActsAsTenant.current_tenant.name %> Log In</h3>
              <%= render partial: "devise/sessions/barangay_form" %>
            <% else %>
              <h4 class="text-center mb-3">Main Log In</h4>
              <%= render partial: "devise/sessions/main_form" %>
            <% end %>

            <div class="text-center mt-3">
              <%= render "devise/shared/links" %>
            </div>
          </div>

          <div class="col-md-6 d-none d-md-block position-relative bg-dark text-white" style="background: url('<%= image_path("login_image.jpg") %>') center/cover no-repeat;">
            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0, 0, 0, 0.5);"></div>
            <div class="position-relative h-100 d-flex flex-column justify-content-center align-items-center px-4 text-center">
              <small class="text-uppercase">This beautiful theme is yours!</small>
              <p class="fw-bold fs-5 mt-3">
                "Best investment I made for a long time. Can only recommend it for other users."
              </p>
              <p class="fst-italic">– Admin User</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
