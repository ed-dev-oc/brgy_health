<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "needs-validation", data: { turbo: false } }) do |f| %>
  <div class="mb-3">
    <%= f.label :email, "Email Address", class: "form-label fw-semibold small" %>
    <div class="input-group">
      <span class="input-group-text bg-light"><i class="bi bi-envelope text-secondary"></i></span>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "you@example.com", required: true %>
    </div>
  </div>

  <div class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <%= f.label :password, "Password", class: "form-label fw-semibold small mb-0" %>
      <% if devise_mapping.recoverable? %>
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "small text-success text-decoration-none fw-medium" %>
      <% end %>
    </div>

    <div class="input-group" data-controller="password-visibility">
      <span class="input-group-text bg-light"><i class="bi bi-lock text-secondary"></i></span>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-control", data: { password_visibility_target: "passwordInput" }, placeholder: "Enter your password", required: true %>
      <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility" aria-label="Toggle password visibility">
        <i class="bi bi-eye" data-password-visibility-target="icon"></i>
      </button>
    </div>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="mb-4 form-check">
      <%= f.check_box :remember_me, class: "form-check-input" %>
      <%= f.label :remember_me, "Keep me signed in on this device", class: "form-check-label small text-secondary" %>
    </div>
  <% end %>

  <div class="d-grid">
    <%= button_tag type: "submit", class: "btn btn-emerald btn-lg" do %>
      Sign In <i class="bi bi-arrow-right ms-1"></i>
    <% end %>
  </div>
<% end %>
