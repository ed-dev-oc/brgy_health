<div class="container py-5 d-flex justify-content-center align-items-center">
  <div class="card shadow border-success p-4" style="max-width: 700px; width: 100%;">

    <div class="text-center mb-4">
      <%= image_tag "logo_no_background.png", alt: "Logo", height: 60, class: "mb-2" %>
      <h4 class="text-success fw-bold">User Registration</h4>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4"
        data-controller="select-philippines-address"
        data-select-philippines-address-region-name-value="<%= resource.barangay&.region %>"
        data-select-philippines-address-province-name-value="<%= resource.barangay&.province %>"
        data-select-philippines-address-city-name-value="<%= resource.barangay&.city %>"
        data-select-philippines-address-brgy-name-value="<%= resource.barangay&.name %>">

        <h6 class="text-success fw-bold mb-3">Address</h6>

        <%= f.fields_for :barangay do |barangay_form| %>
          <div class="row g-3">
            <div class="col-md-6">
              <%= barangay_form.label :region, "Region", class: "form-label" %>
              <%= barangay_form.select :region, [], { include_blank:"Select Region" }, { class: "form-select", data: { "select-philippines-address-target": "regionInput", action: "change->select-philippines-address#regionInputChanged" } }%>
            </div>
            <div class="col-md-6">
              <%= barangay_form.label :province, "Province", class: "form-label" %>
              <%= barangay_form.select :province, [], { include_blank: "Select Province" }, { class: "form-select", data: { "select-philippines-address-target": "provinceInput", action: "change->select-philippines-address#provinceInputChanged" } }%>
            </div>
            <div class="col-md-6">
              <%= barangay_form.label :city, "City", class: "form-label" %>
              <%= barangay_form.select :city, [], { include_blank: "Select City" }, { class: "form-select", data: { "select-philippines-address-target": "cityInput", action: "change->select-philippines-address#cityInputChanged" } }%>
            </div>
            <div class="col-md-6">
              <%= barangay_form.label :name, "Barangay", class: "form-label" %>
              <%= barangay_form.select :name, [], { include_blank: "Select Barangay" }, { class: "form-select", data: { "select-philippines-address-target": "barangayInput", action: "change->select-philippines-address#barangayInputChanged" } }%>
            </div>
          </div>
        <% end %>
      </div>

      <h6 class="text-success fw-bold mb-3">Personal Information</h6>
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :first_name, class: "form-label" %>
          <%= f.text_field :first_name, required: true, autocomplete: "first_name", class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :middle_name, class: "form-label" %>
          <%= f.text_field :middle_name, autocomplete: "middle_name", class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :last_name, class: "form-label" %>
          <%= f.text_field :last_name, required: true, autocomplete: "last_name", class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :suffix, class: "form-label" %>
          <%= f.text_field :suffix, autocomplete: "suffix", class: "form-control" %>
        </div>
      </div>

      <hr class="my-4">
      <h6 class="text-success fw-bold mb-3">Account Information</h6>

      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, required: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, class: "form-label" %>
        <% if @minimum_password_length %>
          <small class="text-muted ms-2">(<%= @minimum_password_length %> characters minimum)</small>
        <% end %>

        <div class="input-group" data-controller="password-visibility">
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control", data: { password_visibility_target: "passwordInput"}, required: true %>
          <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
            <i class="bi bi-eye" data-password-visibility-target="icon"></i>
          </button>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, class: "form-label" %>

        <div class="input-group" data-controller="password-visibility">
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", data: { password_visibility_target: "passwordInput"}, required: true %>
          <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
            <i class="bi bi-eye" data-password-visibility-target="icon"></i>
          </button>
        </div>
      </div>

      <div class="d-grid">
        <%= f.submit "Sign up", class: "btn btn-success fw-bold" %>
      </div>

      <hr class="my-4">

      <div class="text-center">
        <%= link_to "Forgot Password?", new_password_path(resource_name), class: "text-success d-block mb-2" %>
        <%= link_to "Already have an account? Login!", new_session_path(resource_name), class: "text-success" %>
      </div>
    <% end %>
  </div>
</div>
