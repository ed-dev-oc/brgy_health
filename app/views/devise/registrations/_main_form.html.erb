<div class="container py-5">
  <div class="pub-card mx-auto overflow-hidden shadow" style="max-width: 760px;">
    <!-- Top Banner -->
    <div class="p-4 text-white" style="background: linear-gradient(135deg, #064e3b, #0f172a);">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
          <span class="pub-brand-icon">
            <i class="bi bi-building-add"></i>
          </span>
          <div>
            <h4 class="fw-bold mb-0">Register Your Barangay Health Center</h4>
            <small class="opacity-75">Create a Barangay Administrator account and request portal activation</small>
          </div>
        </div>
        <span class="badge badge-soft-emerald">Role: Barangay Admin</span>
      </div>
    </div>

    <div class="p-4 p-md-5 bg-white">
      <!-- Verification Notice Callout -->
      <div class="p-3 rounded-3 mb-4 d-flex align-items-start gap-3" style="background: var(--pub-emerald-50); border: 1px solid #a7f3d0;">
        <i class="bi bi-info-circle-fill text-success fs-5"></i>
        <div class="small text-dark">
          <strong>How Barangay Registration Works:</strong> After submitting this form, our SuperAdmin team will verify your Barangay details. Once approved, you'll receive an email confirmation with your live <code>{barangay}.<%= request.domain %></code> portal link.
        </div>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Step 1: Philippine Barangay Address -->
        <div class="mb-4 pb-4 border-bottom"
          data-controller="select-philippines-address"
          data-select-philippines-address-region-name-value="<%= resource.barangay&.region %>"
          data-select-philippines-address-province-name-value="<%= resource.barangay&.province %>"
          data-select-philippines-address-city-name-value="<%= resource.barangay&.city %>"
          data-select-philippines-address-brgy-name-value="<%= resource.barangay&.name %>">

          <div class="d-flex align-items-center gap-2 mb-3">
            <span class="badge rounded-circle bg-success">1</span>
            <h6 class="fw-bold mb-0 text-dark">Barangay Location (Philippine Geographic Selector)</h6>
          </div>

          <%= f.fields_for :barangay do |barangay_form| %>
            <div class="row g-3">
              <div class="col-md-6">
                <%= barangay_form.label :region, "Region *", class: "form-label fw-semibold small" %>
                <%= barangay_form.select :region, [], { include_blank: "Select Region" }, { class: "form-select", data: { "select-philippines-address-target": "regionInput", action: "change->select-philippines-address#regionInputChanged" } } %>
              </div>
              <div class="col-md-6">
                <%= barangay_form.label :province, "Province *", class: "form-label fw-semibold small" %>
                <%= barangay_form.select :province, [], { include_blank: "Select Province" }, { class: "form-select", data: { "select-philippines-address-target": "provinceInput", action: "change->select-philippines-address#provinceInputChanged" } } %>
              </div>
              <div class="col-md-6">
                <%= barangay_form.label :city, "City / Municipality *", class: "form-label fw-semibold small" %>
                <%= barangay_form.select :city, [], { include_blank: "Select City" }, { class: "form-select", data: { "select-philippines-address-target": "cityInput", action: "change->select-philippines-address#cityInputChanged" } } %>
              </div>
              <div class="col-md-6">
                <%= barangay_form.label :name, "Barangay *", class: "form-label fw-semibold small" %>
                <%= barangay_form.select :name, [], { include_blank: "Select Barangay" }, { class: "form-select", data: { "select-philippines-address-target": "barangayInput", action: "change->select-philippines-address#barangayInputChanged" } } %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Step 2: Administrator Personal Information -->
        <div class="mb-4 pb-4 border-bottom">
          <div class="d-flex align-items-center gap-2 mb-3">
            <span class="badge rounded-circle bg-success">2</span>
            <h6 class="fw-bold mb-0 text-dark">Administrator Personal Information</h6>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :first_name, "First Name *", class: "form-label fw-semibold small" %>
              <%= f.text_field :first_name, required: true, autocomplete: "given-name", class: "form-control", placeholder: "Mateo" %>
            </div>
            <div class="col-md-6">
              <%= f.label :middle_name, "Middle Name", class: "form-label fw-semibold small" %>
              <%= f.text_field :middle_name, autocomplete: "additional-name", class: "form-control", placeholder: "Santos" %>
            </div>
            <div class="col-md-8">
              <%= f.label :last_name, "Last Name *", class: "form-label fw-semibold small" %>
              <%= f.text_field :last_name, required: true, autocomplete: "family-name", class: "form-control", placeholder: "Reyes" %>
            </div>
            <div class="col-md-4">
              <%= f.label :suffix, "Suffix", class: "form-label fw-semibold small" %>
              <%= f.text_field :suffix, autocomplete: "honorific-suffix", class: "form-control", placeholder: "Jr., III, M.D." %>
            </div>
          </div>
        </div>

        <!-- Step 3: Account Credentials -->
        <div class="mb-4">
          <div class="d-flex align-items-center gap-2 mb-3">
            <span class="badge rounded-circle bg-success">3</span>
            <h6 class="fw-bold mb-0 text-dark">Account Credentials</h6>
          </div>

          <div class="row g-3">
            <div class="col-12">
              <%= f.label :email, "Official Email Address *", class: "form-label fw-semibold small" %>
              <%= f.email_field :email, required: true, autocomplete: "email", class: "form-control", placeholder: "admin@barangay.gov.ph" %>
            </div>

            <div class="col-md-6">
              <%= f.label :password, class: "form-label fw-semibold small" do %>
                Password *
                <% if @minimum_password_length %>
                  <span class="text-secondary fw-normal">(<%= @minimum_password_length %> chars min)</span>
                <% end %>
              <% end %>
              <div class="input-group" data-controller="password-visibility">
                <%= f.password_field :password, autocomplete: "new-password", class: "form-control", data: { password_visibility_target: "passwordInput" }, required: true %>
                <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility" aria-label="Toggle password visibility">
                  <i class="bi bi-eye" data-password-visibility-target="icon"></i>
                </button>
              </div>
            </div>

            <div class="col-md-6">
              <%= f.label :password_confirmation, "Confirm Password *", class: "form-label fw-semibold small" %>
              <div class="input-group" data-controller="password-visibility">
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", data: { password_visibility_target: "passwordInput" }, required: true %>
                <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility" aria-label="Toggle password visibility">
                  <i class="bi bi-eye" data-password-visibility-target="icon"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="d-grid mb-3">
          <%= button_tag type: "submit", class: "btn btn-emerald btn-lg" do %>
            <i class="bi bi-check2-circle me-1"></i>Submit Barangay Registration
          <% end %>
        </div>

        <div class="text-center pt-3 border-top">
          <span class="text-secondary small">Already have an account?</span>
          <%= link_to "Sign In Here", new_session_path(resource_name), class: "small fw-semibold text-success text-decoration-none ms-1" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
