<div class="container py-5">
  <div class="d-flex justify-content-center mb-4">
    <%= image_tag 'logo_no_background.png', alt: 'BHC Logo', class: 'img-fluid', style: 'height: 100px;' %>
  </div>

  <div class="row justify-content-center mb-4">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow border-success">
        <div class="card-body text-center">
          <h3 class="text-success">Forgot your password</h3>
          <p>Please enter your email address where you want the password reset information sent to.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow border-success">
        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :email, "Enter email address", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", placeholder: "Email Address", autofocus: true, autocomplete: "email" %>
            </div>

            <div class="d-grid mb-3">
              <%= f.submit "Request reset password", class: "btn btn-success fw-bold" %>
            </div>
          <% end %>

          <div class="text-center">
            <%= link_to "Back to Login", new_session_path(resource_name), class: "text-decoration-none" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
