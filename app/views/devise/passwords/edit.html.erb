<div class="min-vh-100 d-flex flex-column justify-content-center align-items-center bg-white">
  <div class="mb-4">
    <%= image_tag("logo_no_background.png", class: "img-fluid", style: "width: 100px; height: 100px;") %> <!-- Replace with actual logo path -->
  </div>

  <div class="card shadow-sm border-success" style="width: 100%; max-width: 400px;">
    <div class="card-body text-center">

      <h5 class="card-title mb-1">Change your password</h5>
      <p class="text-muted small mb-4">Strong passwords include letters, numbers, and symbols.</p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="mb-3 text-start">
          <div class="input-group" data-controller="password-visibility">
            <%= f.password_field :password, class: "form-control", data: { password_visibility_target: "passwordInput"} %>
            <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
              <i class="bi bi-eye" data-password-visibility-target="icon"></i>
            </button>
          </div>
        </div>

        <div class="mb-4 text-start">
          <div class="input-group" data-controller="password-visibility">
            <%= f.password_field :password_confirmation, class: "form-control", data: { password_visibility_target: "passwordInput"} %>
            <button type="button" class="btn btn-outline-secondary" data-action="click->password-visibility#togglePasswordVisibility">
              <i class="bi bi-eye" data-password-visibility-target="icon"></i>
            </button>
          </div>
        </div>

        <%= f.submit "CONFIRM", class: "btn btn-success w-100 fw-bold" %>
      <% end %>

    </div>
  </div>
</div>
