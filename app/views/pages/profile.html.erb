<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
  <div>
    <h3 class="fw-bold mb-1">Edit SuperAdmin Profile</h3>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">
      Manage your platform administrator profile photo, personal contact info, and login credentials.
    </p>
  </div>
  <span class="badge badge-soft-emerald px-3 py-2">
    <i class="bi bi-shield-check me-1"></i>Platform SuperAdmin
  </span>
</div>

<% if @user.errors.any? %>
  <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
    <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i><%= pluralize(@user.errors.count, "error") %> prevented your profile from being saved:</div>
    <ul class="mb-0 small">
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="row g-4">
  <!-- Left Column: Profile Photo & Identity Card -->
  <div class="col-12 col-lg-4">
    <%= render "super_admin/partials/profile/profile_form" %>
  </div>

  <!-- Right Column: Personal Info & Login Credentials -->
  <div class="col-12 col-lg-8">
    <div class="mb-4">
      <%= render "super_admin/partials/profile/personal_information_form" %>
    </div>
    <div>
      <%= render "super_admin/partials/profile/credentials_form" %>
    </div>
  </div>
</div>
