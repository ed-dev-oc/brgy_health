<section class="pub-page-banner text-center">
  <div class="container">
    <span class="badge badge-soft-emerald mb-2 px-3 py-1">ABOUT THE PLATFORM</span>
    <h1 class="fw-bold display-5 mb-2"><%= @page.title %></h1>
    <% if @page.subheadline.present? %>
      <p class="lead opacity-75 mx-auto mb-0" style="max-width: 680px;">
        <%= @page.subheadline %>
      </p>
    <% end %>
  </div>
</section>

<div class="container py-5">
  <div class="pub-card p-4 p-md-5 mx-auto" style="max-width: 860px;">
    <div class="prose text-secondary mb-4" style="line-height: 1.75;">
      <%= @page.content %>
    </div>

    <div class="row g-3 pt-4 border-top">
      <div class="col-md-4">
        <div class="p-3 rounded-3 bg-light h-100">
          <i class="bi bi-people-fill text-success fs-4"></i>
          <h6 class="fw-bold text-dark mt-2 mb-1">Community-Centered</h6>
          <small class="text-secondary">Organized by Purok and Zone for accurate local healthcare outreach.</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 rounded-3 bg-light h-100">
          <i class="bi bi-bell-fill text-success fs-4"></i>
          <h6 class="fw-bold text-dark mt-2 mb-1">Multi-Channel Alerts</h6>
          <small class="text-secondary">In-app notifications, WebPush, and email countdown reminders.</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 rounded-3 bg-light h-100">
          <i class="bi bi-shield-lock-fill text-success fs-4"></i>
          <h6 class="fw-bold text-dark mt-2 mb-1">Tenant-Isolated</h6>
          <small class="text-secondary">Each barangay operates securely on its own verified subdomain.</small>
        </div>
      </div>
    </div>
  </div>
</div>
