<% if @hero_banner.present? %>
  <section class="hero-banner" style="background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), 
    url(<%= url_for(@hero_banner.image) if @hero_banner.image.attached? %>);">
    <div class="container">
      <div class="hero-content">
        <h1 class="display-4 fw-bold mb-4"><%= @hero_banner.title %></h1>
        <p class="lead mb-4"><%= @hero_banner.subheadline %></p>
      </div>
    </div>
  </section>
<% end %>

<% if @barangays.any? %>
  <section class="registered-barangay py-5">
    <div class="text-center mb-3">
      <h2>
        <i class="bi bi-house-door-fill"></i>
        Registered Barangay
      </h2>
    </div>

    <div id="carouselBarangay" class="carousel slide">
      <div class="carousel-indicators">
        <% @barangays.count.times do |index| %>
          <button type="button" data-bs-target="#carouselBarangayIndicators" data-bs-slide-to="<%= index %>" class="<%= index == 0 ? 'active' : '' %>" aria-label="Slide <%= index %>"></button>
        <% end %>
      </div>
      <div class="carousel-inner">
        <% @barangays.each_with_index do |barangay, index| %>
          <div class="carousel-item <%= index == 0 ? 'active' : '' %>">
            <% if barangay.pages.homepage_hero_banner.first&.image&.attached? %>
              <%= image_tag(barangay.pages.homepage_hero_banner.first.image.variant(resize_to_fill: [600, 200]), class: "d-block w-100") %>
            <% else %>
              <%= image_tag("hero_banner.png", class: "d-block w-100", style: "height: 200px; object-fit: cover;") %>
            <% end %>
            <div class="carousel-caption d-none d-md-block pb-5" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.7);">
              <h5><i class="bi bi-house-door-fill me-1"></i><%= barangay.name %></h5>
              <%= link_to root_url(subdomain: barangay.slug), class: "link-light link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" do %>
                <i class="bi bi-geo-alt-fill me-1"></i>
                <%= barangay.full_address %> (View Page)
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselBarangay" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselBarangay" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </section>
<% end %>

<% if @testimonials.any? %>
  <section class="testimonial py-5">
    <div class="text-center mb-3">
      <h2>
        <i class="bi bi-chat-left-quote"></i>
        Testimonials
      </h2>
    </div>

    <div id="carouselTestimonial" class="carousel carousel-dark slide">
      <div class="carousel-indicators">
        <% @testimonials.count.times do |index| %>
          <button type="button" data-bs-target="#carouselTestimonialIndicators" data-bs-slide-to="<%= index %>" class="<%= index == 0 ? 'active' : '' %>" aria-label="Slide <%= index %>"></button>
        <% end %>
      </div>
      <div class="carousel-inner">
        <% @testimonials.each_with_index do |testimonial, index| %>
          <div class="carousel-item <%= index == 0 ? 'active' : '' %>">
            <div class="d-flex justify-content-center p-5">
              <div class="card text-center border-0 shadow w-75">
                <div class="card-body">
                  <p class="card-text text-wrap"><%= testimonial.data %></p>
                  <h5 class="card-title d-flex text-start justify-content-center align-items-center gap-2">
                    <span><%= image_tag(profile_url(testimonial.user), class: "rounded-circle", size: "32x32")  %></span>
                    <span class="">
                      <p class="lh-1 small m-0"><span class="text-primary"><%= testimonial.user.full_name %></span><br>
                        <span class="text-muted"><%= testimonial.user.email %></span></p>
                    </span>
                  </h5>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselTestimonial" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselTestimonial" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </section>
<% end %>
