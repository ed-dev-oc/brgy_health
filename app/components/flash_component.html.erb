<turbo-frame id="flash">
  <div class="flash-toast-stack">
    <% @flash.each do |type, message| %>
      <% next if message.blank? %>
      <div data-controller="flash" class="<%= css_class(type) %>" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="flash-icon-badge">
          <i class="bi <%= icon(type) %>"></i>
        </div>

        <div class="flash-content">
          <div class="flash-title"><%= title(type) %></div>
          <p class="flash-message m-0"><%= message %></p>
        </div>

        <button type="button"
                class="flash-close-btn"
                data-action="click->flash#close_message"
                aria-label="Close notification"
                title="Dismiss">
          <i class="bi bi-x-lg"></i>
        </button>

        <div class="flash-progress-bar"></div>
      </div>
    <% end %>
  </div>
</turbo-frame>
